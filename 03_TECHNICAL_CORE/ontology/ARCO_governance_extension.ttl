@prefix :    <https://arco.ai/ontology/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix ro:  <http://purl.obolibrary.org/obo/RO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos:<http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://arco.ai/ontology/governance>
a owl:Ontology ;
rdfs:label "ARCO Governance Extension — Entailment-First Regulatory Classification"@en ;
rdfs:comment "Governance, intended use, and regulatory classification layer. AnnexIII1aApplicableSystem is OWL-entailed from three gates: capability + intended use + use scenario. Demonstrated under owlrl." ;
owl:versionInfo "Foundational ontology alignment: BFO 2020 (ISO/IEC 21838-2:2021) loaded as a full upstream file via ARCO_core.ttl; OBO Relations Ontology release 2025-12-17, Information Artifact Ontology release 2026-03-30, and Common Core Ontologies release v1.7-2024-11-03 loaded as ROBOT BOT-extracted slim modules per the OBO Foundry / ODK standard pattern. CCO terms in this file (Organization, DirectiveInformationContentEntity, DescriptiveInformationContentEntity, DesignativeInformationContentEntity, prescribes, designates, has_output, Person) use IRI namespace http://www.ontologyrepository.com/CommonCoreOntologies/ (pre-v2.0, matching the pinned cco_bot.owl). Three of the local declarations (DirectiveICE, DescriptiveICE, and DesignativeICE rdfs:subClassOf iao:0000030) are bridging assertions that wire CCO's ICE hierarchy to IAO's iao:0000030 — the stubs that do non-trivial work; the rest are redundant with cco_bot.owl and kept for in-file readability. Regulatory source: Regulation (EU) 2024/1689, official version of 13 June 2024; current ARCO encoding covers Article 6 / Annex III points 1(a) and 5(b)." ;
owl:imports <https://arco.ai/ontology/core> .
# NOTE: owl:imports references the core ontology IRI. rdflib does not follow
# owl:imports automatically; all TTL files are loaded explicitly by the pipeline.
# Tools that do follow owl:imports will need a local catalog or network access.

# Design Decisions (rationale for the choices below):
#
#   Inverse aboutness: AnnexIII1aApplicableSystem uses anonymous inverse
#   property expressions [owl:inverseOf iao:0000136] in its equivalentClass
#   axiom. This is OWL 2 DL expressible. owlrl materializes it correctly.
#   SHACL qualified shapes + SPARQL ASK queries provide fallback validation
#   if a different reasoner does not materialize inverse restrictions.
#
#   OWL 2 punning: several ARCO IRIs occupy both class and individual
#   positions. This is legal OWL 2 DL; under the Direct Semantics the class
#   and individual interpretations of a punned IRI are independent. Two
#   distinct uses with different load:
#   (1) Traceability aboutness — iao:0000136 / cco:prescribes assertions
#       whose object is a class IRI (e.g., a condition ICE is_about
#       :BiometricIdentificationCapability). Documentary only: no
#       classification entailment consumes these triples (checked set: the
#       HermiT justifications for the four positive conclusions on the
#       committed fixtures contain none of them).
#   (2) Gate-3 designation — cco:designates owl:hasValue :NaturalPersonRole.
#       This IS classification-load-bearing. The entailment uses
#       :NaturalPersonRole strictly as a named individual (hasValue
#       semantics); the class axioms on the same IRI play no role in the
#       derivation, and no axiom bridges the two readings. Reading that
#       individual as a proxy for the role category is ARCO's documented
#       modeling intent, not an OWL semantic consequence and not a
#       CCO-documented use (CCO's designates examples all target
#       particulars); see LIMITATIONS.md §3.1 and OPEN_PROBLEMS.md X.12 /
#       L2.7.
#
#   Class-level restrictions are general: IntendedUseSpecification prescribes
#   some Process and is_about some System; UseScenarioSpecification is_about
#   some System (no class-level role restriction — the designated role
#   category sits on the instance via cco:designates). Annex III category
#   specifics belong on instances, keeping the schema extensible to 1(b),
#   1(c), etc.


#################################################################
# 1) ACTORS + ROLES
#################################################################

:ProviderOrganization rdf:type owl:Class ;
  rdfs:label "Provider Organization"@en ;
  skos:definition "An organization that develops or places an AI system on the market under the EU AI Act."@en ;
  rdfs:subClassOf cco:Organization ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ro:0000087 ;   # has role
    owl:someValuesFrom :ProviderRole
  ] .

:ProviderRole rdf:type owl:Class ;
  rdfs:label "Provider Role"@en ;
  skos:definition "The role of providing an AI system, borne by a provider organization."@en ;
  rdfs:subClassOf bfo:0000023 .   # Role

:DeployerRole rdf:type owl:Class ;
  rdfs:label "Deployer Role"@en ;
  skos:definition "The role of deploying an AI system, borne by an entity that uses the system under its own authority. Distinct from provider, which develops or places the system on the market."@en ;
  rdfs:comment "Role borne by an entity that deploys an AI system. Distinct from provider (who develops/places on market)." ;
  rdfs:subClassOf bfo:0000023 .   # Role

#################################################################
# 2) DOCUMENTATION WORKFLOW
#################################################################

:AssessmentDocumentationProcess rdf:type owl:Class ;
  rdfs:label "Assessment Documentation Process"@en ;
  skos:definition "A process by which a provider documents the outcome of an Annex III applicability assessment for an AI system, producing assessment documentation as its output."@en ;
  rdfs:subClassOf bfo:0000015 ; # Process
  rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ro:0000057 ; owl:someValuesFrom :System ] ,
    [ a owl:Restriction ; owl:onProperty ro:0000057 ; owl:someValuesFrom :ProviderOrganization ] ,
    [ a owl:Restriction ; owl:onProperty cco:has_output ; owl:someValuesFrom :AssessmentDocumentation ] .

:AssessmentDocumentation rdf:type owl:Class ;
  rdfs:label "Assessment Documentation"@en ;
  skos:definition "A documentation artifact recording an Annex III applicability assessment. Refers to the system assessed and the regulatory content applied."@en ;
  rdfs:comment "A documentation artifact produced by the assessment documentation process; traceable to the assessed system and the regulatory content applied." ;
  rdfs:subClassOf :InformationOutput ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;  # is about
    owl:someValuesFrom :System
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;  # is about
    owl:someValuesFrom :RegulatoryContent
  ] .

#################################################################
# 3) CCO DECLARATIONS — bridging assertions + redundant locals
#
# CCO is loaded as a ROBOT BOT-extracted slim module (cco_bot.owl) via
# ARCO_core.ttl's import chain. Three of the declarations below do
# non-trivial work as IAO/CCO bridging assertions:
#   - cco:DirectiveInformationContentEntity rdfs:subClassOf iao:0000030
#   - cco:DescriptiveInformationContentEntity rdfs:subClassOf iao:0000030
#   - cco:DesignativeInformationContentEntity rdfs:subClassOf iao:0000030
# These wire CCO's ICE hierarchy to IAO's iao:0000030 (upstream CCO does
# not formally link cco:InformationContentEntity to iao:0000030).
#
# The remaining declarations (cco:prescribes, cco:has_output, cco:Person,
# cco:Organization) are redundant with cco_bot.owl. They are retained for
# in-file readability so a reader can see the full set of CCO terms used
# without cross-referencing the BOT module. A future cleanup may remove
# the redundant locals.
#################################################################

cco:DirectiveInformationContentEntity rdf:type owl:Class ;
  rdfs:label "Directive Information Content Entity"@en ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

cco:DescriptiveInformationContentEntity rdf:type owl:Class ;
  rdfs:label "Descriptive Information Content Entity"@en ;
  rdfs:comment "ICE that describes or reports states of affairs. Examples: compliance determinations, assessment documentation, operational outputs. Contrast with DirectiveInformationContentEntity (prescribes behavior)." ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

cco:DesignativeInformationContentEntity rdf:type owl:Class ;
  rdfs:label "Designative Information Content Entity"@en ;
  rdfs:comment "ICE that uniquely distinguishes an entity by inscription. Pinned CCO examples: a URL designating a Web Page, a person's name designating that person, a vehicle identification number designating a vehicle — all particulars. ARCO additionally uses a Designative ICE to designate an affected role category via OWL 2 punning (class IRI as named individual); that category-designation use is ARCO's documented intent, not a CCO-documented use (LIMITATIONS.md §3.1). CCO declares this class disjoint with DirectiveInformationContentEntity and DescriptiveInformationContentEntity, so a single ICE cannot be typed as both a Designative ICE and a Directive ICE." ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

# Three D's subtyping — map existing ARCO ICE classes to directive/descriptive.
# Convention note: each of the three ARCO classes below also asserts
# rdfs:subClassOf iao:0000030 directly in ARCO_core.ttl. That parent is
# entailed here anyway via the Three-D parent's own iao:0000030 bridge
# above, so the double assertion is chain-internal redundancy kept so each
# file reads standalone — a single lineage, not multiple inheritance.
:RegulatoryContent rdfs:subClassOf cco:DirectiveInformationContentEntity .
:InformationOutput rdfs:subClassOf cco:DescriptiveInformationContentEntity .
:ComplianceDetermination rdfs:subClassOf cco:DescriptiveInformationContentEntity .

cco:prescribes rdf:type owl:ObjectProperty ;
  rdfs:label "prescribes"@en ;
  rdfs:comment "A directive ICE prescribes a process type as a rule or guide. Domain: DirectiveInformationContentEntity (pinned declaration, cco_bot.owl). The pinned declaration carries NO range; the only inherited range constraint is the parent cco:is_about's bfo:0000001 (Entity), and the pinned definition admits both Occurrent and Continuant targets. ARCO's Gate-2 use targets typed process tokens." .

cco:designates rdf:type owl:ObjectProperty ;
  rdfs:label "designates"@en ;
  rdfs:comment "x designates y iff x is an instance of an Information Content Entity, and y is an instance of an Entity, such that given some context, x uniquely distinguishes y from other entities (pinned CCO v1.7 definition). The pinned declaration carries domain DesignativeInformationContentEntity and NO range; the only inherited range constraint is the parent cco:is_about's bfo:0000001. In ARCO, Gate 3 uses this property with owl:hasValue :NaturalPersonRole — an OWL 2 pun in which the class IRI stands as a named individual for the role category. Designating a category is ARCO's disclosed extension of the CCO pattern, not a CCO-documented use (LIMITATIONS.md §3.1). cco_bot.owl declares this rdfs:subPropertyOf cco:is_about; the local declaration here additionally asserts rdfs:subPropertyOf iao:0000136 (is_about), reflecting designation up to ARCO's is_about layer." ;
  rdfs:subPropertyOf iao:0000136 .  # is about

cco:has_output rdf:type owl:ObjectProperty ;
  rdfs:label "has output" .

cco:Person rdf:type owl:Class ;
  rdfs:label "Person"@en ;
  rdfs:subClassOf bfo:0000040 . # Material Entity

cco:Organization rdf:type owl:Class ;
  rdfs:label "Organization"@en ;
  rdfs:subClassOf bfo:0000027 . # Object Aggregate

#################################################################
# 3a) REGULATORY CONTENT — Annex III conditions (universal)
#
# These ICE instances describe what EU AI Act Regulation (EU) 2024/1689
# Annex III prescribes for the modeled categories. They are universal
# regulatory content (one ICE per Annex III condition modeled), not
# per-fixture data. Every fixture references them via iao:0000136
# from its :AssessmentDocumentation.
#
# Pattern: a regulatory condition ICE has type :RegulatoryContent,
# prescribes the regulated process type via cco:prescribes, and is_about
# the capability / process / role universals via iao:0000136.
#
# Moved from per-fixture files (Sentinel, CreditScoring) on 2026-05-14
# to close regulatory_alignment FAIL on Adversarial and FlagTest fixtures.
#################################################################

:AnnexIII_List rdf:type :RegulatoryContent ;
  rdfs:label "Annex III List" ;
  bfo:0000051 :AnnexIII_Condition_1a ;
  bfo:0000051 :AnnexIII_Condition_5b .

:AnnexIII_Condition_1a rdf:type :RegulatoryContent ;
  rdfs:label "Annex III 1(a) (Biometric Rule)" ;
  rdfs:comment "Annex III item 1(a): remote biometric identification systems (Article 3(41)), with the biometric-verification carve-out. cco:prescribes targets the regulated process TYPE (class IRI as concept-individual via OWL 2 punning) — the regulation prescribes process types, not deployment-specific tokens." ;
  cco:prescribes :RemoteBiometricIdentificationProcess ;
  iao:0000136 :BiometricIdentificationCapability ;
  iao:0000136 :RemoteBiometricIdentificationProcess ;
  iao:0000136 :NaturalPersonRole .

:AnnexIII_Condition_5b rdf:type :RegulatoryContent ;
  rdfs:label "Annex III 5(b) (Creditworthiness Rule)" ;
  rdfs:comment "Annex III item 5(b): AI systems intended to be used to evaluate the creditworthiness of natural persons or establish their credit score, with the exception of AI systems used for the purpose of detecting financial fraud. cco:prescribes targets the regulated process TYPE (class IRI as concept-individual via OWL 2 punning)." ;
  cco:prescribes :CreditworthinessEvaluationProcess ;
  iao:0000136 :CreditworthinessEvaluationCapability ;
  iao:0000136 :CreditworthinessEvaluationProcess ;
  iao:0000136 :NaturalPersonRole .

#################################################################
# 3b) REGULATORY BRIDGE AXIOMS
#
# AnnexIIITriggeringCapability is a REGULATORY GROUPING CLASS,
# not a BFO natural kind. There is no mind-independent property
# shared by all triggering capabilities in reality. What makes
# a capability "triggering" is the legal text of Annex III.
#
# Modeled as a DEFINED class: its extension is fixed by an
# owl:equivalentClass owl:unionOf over the listed member capability
# classes. Each member IS a real BFO disposition (subclass of
# :Capability), but the GROUPING is definitionally
# extensional rather than primitive. This is the BFO-defensible
# move: membership is fixed by extrinsic regulatory criterion
# (Article 6 / Annex III of Regulation (EU) 2024/1689), not by
# any mind-independent causal structure shared across members.
#
# Adding a new Annex III capability category requires:
#   (a) adding the new class to the owl:unionOf list, and
#   (b) asserting rdfs:subClassOf :AnnexIIITriggeringCapability
#       for in-file readability and OBO Foundry convention.
# (b) is entailed by (a) but stated explicitly.
#
# HighRiskSystem is also a regulatory determination concept.
# Its bridge axiom depends on AnnexIIITriggeringCapability and
# belongs in this layer.
#################################################################

:AnnexIIITriggeringCapability rdf:type owl:Class ;
  rdfs:label "Annex III Triggering Capability"@en ;
  skos:definition "A capability whose presence in an AI system component triggers Annex III applicability under Regulation (EU) 2024/1689. Membership is the union of capability classes named by Annex III, fixed by the regulation rather than by any single shared physical property."@en ;
  rdfs:comment "Defined class. Membership is the union of capability classes named by Annex III of Regulation (EU) 2024/1689, fixed by regulation rather than by primitive subsumption. Each member is a real BFO capability disposition; the grouping is by extrinsic regulatory criterion under Article 6. The rdfs:subClassOf :Capability relationship is entailed by the union (each member is a Capability); not stated explicitly to avoid redundancy. Adding a new Annex III capability category requires (a) adding the new class to the owl:unionOf list and (b) asserting rdfs:subClassOf :AnnexIIITriggeringCapability for in-file readability." ;
  :hasRegulatoryBasis "Regulation (EU) 2024/1689, Article 6(2) and Annex III"@en ;
  :hasRegulatoryBasis "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"^^xsd:anyURI ;
  skos:scopeNote "Defined class (not a universal): its instances are real BFO capability dispositions; the GROUPING (owl:unionOf over member capability classes) is determined by Regulation (EU) 2024/1689 Annex III as named under Article 6(2), not by a single shared physical property in reality. Fiat/bona-fide boundary distinction used analogically per docs/modeling_decisions/decisions_justification_map.md S3a: members are bona-fide capability kinds; the regulatory grouping is a fiat partition by extrinsic criterion under Article 6, not a natural joint."@en ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:unionOf (
      :BiometricIdentificationCapability
      :CreditworthinessEvaluationCapability
    )
  ] .

# Explicit subclass assertions: entailed by the union above, but stated
# for in-file readability and OBO Foundry convention.
# BiometricVerificationCapability is NOT a member of the union; 1:1
# verification does not trigger Annex III 1(a).
:BiometricIdentificationCapability rdfs:subClassOf :AnnexIIITriggeringCapability .
:CreditworthinessEvaluationCapability rdfs:subClassOf :AnnexIIITriggeringCapability .

:HighRiskSystem rdf:type owl:Class ;
  rdfs:label "Annex III Capability-Precondition Flag"@en ;
  skos:definition "An AI system that bears, via one of its components, a capability in the Annex III triggering set. Membership fires from Gate 1 alone (the capability precondition); full Annex III applicability requires all three gates and is recorded by the category-specific applicable-system classes."@en ;
  rdfs:comment "Latent-risk flag. Membership is satisfied by Gate 1 alone: the system has a SystemComponent that bears a disposition belonging to AnnexIIITriggeringCapability. This class is INFERRED by the reasoner and presented in the certificate as LATENT-RISK FLAG. It is NOT the full legal high-risk category — that requires all three gates (capability + intended use + use scenario) and is captured by the category-specific classes (AnnexIII1aApplicableSystem, AnnexIII5bApplicableSystem). The IRI is retained as :HighRiskSystem for backward compatibility with downstream consumers; the rdfs:label and this comment reflect what the axiom actually entails. The rdfs:subClassOf :System parent is entailed by the equivalentClass intersection (its first conjunct is :System) and is not stated explicitly, to avoid redundancy; the sibling classes :AnnexIII1aApplicableSystem and :AnnexIII5bApplicableSystem assert it for in-file readability." ;
  :hasRegulatoryBasis "Regulation (EU) 2024/1689, Article 6 and Annex III"@en ;
  :hasRegulatoryBasis "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"^^xsd:anyURI ;
  skos:scopeNote "Defined class (not a universal): its instances are AI systems bearing a triggering-capability disposition via a SystemComponent; extension fixed by the latent-flag Gate-1-only axiom. The class denotes systems bearing the triggering capability, not the act of flagging them. This is the LATENT-FLAG layer, NOT the EU AI Act legal high-risk classification — the full Annex III applicability requires three gates per :AnnexIII1aApplicableSystem / :AnnexIII5bApplicableSystem. Fiat/bona-fide boundary distinction used analogically per S3a: instances are real systems; the partition criterion is regulatory under Article 6, not a natural joint."@en ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :System
      [ rdf:type owl:Restriction ;
        owl:onProperty bfo:0000051 ;   # has part
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :SystemComponent
            [ rdf:type owl:Restriction ;
              owl:onProperty ro:0000091 ;  # has disposition
              owl:someValuesFrom :AnnexIIITriggeringCapability
            ]
          )
        ]
      ]
    )
  ] .

#################################################################
# 4) INTENDED USE MODELING (CCO Directive ICE Pattern)
#
# Annex III: "AI systems intended to be used for [process] of
# [affected entities]". Three-gate classification:
#   Gate 1: Capability (reality-side disposition)
#   Gate 2: Intended use (directive ICE prescribes process type)
#   Gate 3: Use scenario (affected entities)
#################################################################

:IntendedUseSpecification rdf:type owl:Class ;
  rdfs:label "Intended Use Specification"@en ;
  skos:definition "A specification document stating the process the AI system is intended to perform. Anchored to the EU AI Act Article 3(12) definition of intended purpose, which references instructions for use, promotional or sales material, and technical documentation."@en ;
  rdfs:comment "A directive ICE that prescribes the process type an AI system is intended to realize. Class-level restrictions enforce that it prescribes some Process and is about some System. The specific process type (e.g., biometric identification) is on the instance, not the class." ;
  rdfs:subClassOf cco:DirectiveInformationContentEntity ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cco:prescribes ;
    owl:someValuesFrom bfo:0000015   # Process (general — instance carries specifics)
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom :System
  ] .

:RemoteBiometricIdentificationIntendedUseSpec rdf:type owl:Class ;
  rdfs:label "Remote Biometric Identification Intended Use Specification"@en ;
  skos:definition "Defined class. Membership is the class of intended-use specifications (Directive ICEs) that prescribe a :RemoteBiometricIdentificationProcess (some process particular of that regulated kind; the OWL restriction cco:prescribes someValuesFrom is existential over particulars, not designation of the universal). :RemoteBiometricIdentificationProcess is ARCO's process encoding of the Annex III 1(a) trigger (Annex III 1(a) names a remote-biometric-identification system category; ARCO derives the corresponding process). The class boundary is fixed by the regulation rather than by any natural-kind property of intended-use specifications in general."@en ;
  rdfs:comment "Membership at the particular level is non-exclusive: a single IntendedUseSpecification instance may also fall in another regulated subkind if it prescribes multiple regulated process kinds." ;
  rdfs:subClassOf :IntendedUseSpecification ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :IntendedUseSpecification
      [ rdf:type owl:Restriction ;
        owl:onProperty cco:prescribes ;
        owl:someValuesFrom :RemoteBiometricIdentificationProcess ]
    )
  ] .

:CreditworthinessEvaluationIntendedUseSpec rdf:type owl:Class ;
  rdfs:label "Creditworthiness Evaluation Intended Use Specification"@en ;
  skos:definition "Defined class. Membership is the class of intended-use specifications (Directive ICEs) that prescribe a :CreditworthinessEvaluationProcess (some process particular of that regulated kind; the OWL restriction cco:prescribes someValuesFrom is existential over particulars, not designation of the universal). :CreditworthinessEvaluationProcess is ARCO's process encoding of the Annex III 5(b) trigger (Annex III 5(b) names AI systems intended to evaluate creditworthiness; ARCO derives the corresponding process). The class boundary is fixed by the regulation rather than by any natural-kind property of intended-use specifications in general."@en ;
  rdfs:comment "Membership at the particular level is non-exclusive: a single IntendedUseSpecification instance may also fall in another regulated subkind if it prescribes multiple regulated process kinds." ;
  rdfs:subClassOf :IntendedUseSpecification ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :IntendedUseSpecification
      [ rdf:type owl:Restriction ;
        owl:onProperty cco:prescribes ;
        owl:someValuesFrom :CreditworthinessEvaluationProcess ]
    )
  ] .

:UseScenarioSpecification rdf:type owl:Class ;
  rdfs:label "Use Scenario Specification"@en ;
  skos:definition "A specification document stating the use scenario for an AI system, including which role category is affected (for example, natural persons). Designates the affected role universal by name."@en ;
  rdfs:comment "A Designative ICE that constrains the realization context by designating the affected role universal. iao:is_about anchors aboutness to the system; cco:designates carries the typed designation of the affected role category (e.g., :NaturalPersonRole) at the universal level. Modeled as cco:DesignativeInformationContentEntity (not Directive) because the artifact identifies WHICH role category is affected; CCO declares Designative and Directive ICE disjoint, so this class cannot be both. The specific designated role universal (e.g., NaturalPersonRole) is the value of cco:designates on the instance; class-level restriction here only requires aboutness to a System." ;
  rdfs:subClassOf cco:DesignativeInformationContentEntity ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom :System
  ] .

# GENUS (Art 3(35)): general biometric identification process (1:N). Its subkinds are
# distinguished by the differentia of the subject's active involvement (Art 3(41)).
:BiometricIdentificationProcess rdf:type owl:Class ;
  rdfs:label "Biometric Identification Process"@en ;
  skos:definition "A process that establishes a person's identity by comparing their biometric data against a set of stored reference data (one-to-many matching)."@en ;
  skos:scopeNote "The deliberately non-triggering parent genus: a use specification prescribing only the bare genus does not satisfy Gate 2 of Annex III 1(a). The trigger sits on the remote subkind :RemoteBiometricIdentificationProcess (operative Annex III item 1(a) under Article 6(2)). Article 3(35) defines this 1:N identification and Article 3(41) the remoteness of the triggering subkind; both are definitional, with no trigger force on their own."@en ;
  rdfs:comment "ARCO mints this genus so a plain identification process can be a positive process kind rather than a bare absence. A bare-genus token has its remoteness undetermined under the open-world assumption (it is not a positive claim of non-remoteness; whether a given deployment is remote per Article 3(41) is a deployer-elicitation question). It is the parent of the regulated :RemoteBiometricIdentificationProcess but is not itself a Gate-2 target: Gate 2 of Annex III 1(a) keys on the remote subkind, so a use specification prescribing only the bare genus does not trigger 1(a). The 1:N differentia is prose and regulation only; the genus carries no restriction axiom. The natural-person restriction is not carried here either; Gate 3 enforces the affected population." ;
  rdfs:subClassOf bfo:0000015 . # Process

:RemoteBiometricIdentificationProcess rdf:type owl:Class ;
  rdfs:label "Remote Biometric Identification Process"@en ;
  skos:definition "A biometric identification process carried out without the subject's active involvement, typically at a distance, by comparing biometric data against a set of stored reference data (one-to-many matching)."@en ;
  skos:scopeNote "ARCO's process encoding of the Annex III 1(a) trigger (Annex III 1(a) names a remote-biometric-identification system category; ARCO models the corresponding process): a documented intended use prescribing it supplies Gate 2 (necessary with the Gate 1 capability and the Gate 3 natural-person role, not sufficient alone). High-risk status is operative through Annex III item 1(a) under Article 6(2); Article 3(35) defines the 1:N identification genus and Article 3(41) the remote (without active involvement) differentia."@en ;
  rdfs:comment "Remote identification, working out who an unknown person is by one-to-many matching, without their cooperation and usually at a distance, is the specific process the Annex III 1(a) biometric rule turns on. It is the Gate-2 target of Annex III 1(a) alone, reached not directly but through the intended-use subkind that prescribes it (cco:prescribes is the load-bearing predicate). It is a primitive subclass with no restriction axiom. Its without-active-involvement differentia lives only in prose, not in an axiom on this class, so a token is not structurally distinguishable from a bare :BiometricIdentificationProcess; the differentia is NOT inherited from the genus, which does not carry it. Its disjointness from verification IS inherited from the genus (asserted disjoint from :BiometricVerificationProcess). ARCO does not model the Article 5 real-time-RBI prohibition, so a real-time particular would still entail 1(a) with no prohibition flag (disclosed at LIMITATIONS §3.7.c)." ;
  rdfs:subClassOf :BiometricIdentificationProcess .

:PostRemoteBiometricIdentificationProcess rdf:type owl:Class ;
  rdfs:label "Post Remote Biometric Identification Process"@en ;
  skos:definition "A remote biometric identification process other than a real-time remote biometric identification process, per Article 3(43) of Regulation (EU) 2024/1689. Identification typically uses biometric data captured before its application."@en ;
  rdfs:comment "Subclass declared for forward extensibility. ARCO does not currently type any fixture into this subclass; the parent :RemoteBiometricIdentificationProcess is what Annex III 1(a) Gate 2 references via someValuesFrom, and subclass propagation handles future post-typed instances. Article 5(1)(h) routing for the disjoint real-time subclass is scoped future work." ;
  rdfs:subClassOf :RemoteBiometricIdentificationProcess .

:RealTimeRemoteBiometricIdentificationProcess rdf:type owl:Class ;
  rdfs:label "Real-Time Remote Biometric Identification Process"@en ;
  skos:definition "A remote biometric identification process in which the capturing of biometric data, the comparison, and the identification all occur without a significant delay (including limited short delays to avoid circumvention). Tracks the real-time criterion of Article 3(42) of Regulation (EU) 2024/1689, which defines the corresponding real-time remote biometric identification system."@en ;
  rdfs:comment "Subclass declared for forward extensibility. ARCO does not currently type any fixture into this subclass and does not yet route to the Article 5(1)(h) prohibited-practice class. Under the current parent-class Gate 2, an IUS prescribing a real-time RBI particular would entail Annex III 1(a) applicability without an Article 5 prohibition flag; this is a deliberate scope-narrowing pending future deployer-context modeling." ;
  rdfs:subClassOf :RemoteBiometricIdentificationProcess .

:PostRemoteBiometricIdentificationProcess
  owl:disjointWith :RealTimeRemoteBiometricIdentificationProcess .

# Regulatory-fiat annotation on the post-vs-real-time disjointness.
# Article 3(42) defines real-time RBI (capture/comparison/identification without
# significant delay); Article 3(43) defines post RBI (everything else). The
# temporal-delay boundary is regulatory — there is a continuum of capture-to-
# identification latencies in real systems; the cut at "significant delay" is a
# fiat line drawn by the regulation. The regulatory CONSEQUENCE (real-time RBI
# routing toward Article 5(1)(h) prohibited-practice analysis) is fiat-shaped.
# See OPEN_PROBLEMS.md X.13 and decisions_justification_map.md S3a.
[ a owl:Axiom ;
  owl:annotatedSource :PostRemoteBiometricIdentificationProcess ;
  owl:annotatedProperty owl:disjointWith ;
  owl:annotatedTarget :RealTimeRemoteBiometricIdentificationProcess ;
  :hasRegulatoryBasis "Regulation (EU) 2024/1689, Article 3(42) (real-time RBI definition), Article 3(43) (post RBI definition)"@en ;
  :hasRegulatoryBasis "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"^^xsd:anyURI ;
  skos:scopeNote "Real-time vs post temporal-delay distinction. The underlying latency continuum is real (capture-to-identification timing is a continuous parameter of system behavior); the cut at 'significant delay' that distinguishes the two regulatory subkinds is drawn by Articles 3(42) and 3(43). The downstream regulatory consequence — real-time RBI routing toward Article 5(1)(h) prohibited-practice analysis (scoped future work; see :RealTimeRemoteBiometricIdentificationProcess rdfs:comment) — is fiat-shaped. Fiat/bona-fide boundary distinction used analogically per S3a: the latency parameter is bona fide; the partition by 'significant delay' is fiat under Articles 3(42), 3(43)."@en
] .

# NON-REMOTE / non-regulated cases are deliberately NOT minted as a positive class. Per
# Regulation (EU) 2024/1689 there is no "cooperative identification" category: the at-the-door /
# premises-access case is biometric VERIFICATION (1:1), excluded by Recital 15 and Recital 17
# (both name "security access to premises"), modeled by :BiometricVerificationProcess below; and
# 1:N identification not asserted to be remote is the bare genus :BiometricIdentificationProcess,
# which does not satisfy Gate 2 (keyed on :RemoteBiometricIdentificationProcess). Whether a given
# walk-up 1:N deployment is "remote" (without active involvement, Art 3(41)) is a deployer-
# elicitation question, not a baked-in class. (An earlier draft minted a :Cooperative... subkind;
# removed as an invented regulatory category after verbatim source audit of Recitals 15 and 17.)

:BiometricVerificationProcess rdf:type owl:Class ;
  rdfs:label "Biometric Verification Process"@en ;
  skos:definition "A process that confirms a person's claimed identity by comparing biometric data one-to-one against a single previously provided reference."@en ;
  skos:scopeNote "Out of scope of Annex III 1(a) by the operative carve-out for biometric verification (Annex III 1(a) second sentence; Recitals 15, 17). Article 3(36) defines this 1:1 verification, as distinct from 1:N identification (Article 3(35)); the regulated 1(a) process is instead remote identification (remote per Article 3(41))."@en ;
  rdfs:comment "Verification confirms a claimed identity one-to-one; identification finds an unknown person one-to-many. ARCO keeps them as disjoint process kinds, and this one is the target of no Annex III gate, which is why a verification-only system is not 1(a)-applicable (the negative classification rests on the capability and intended-use gates, not on this disjointness). The 1:1 differentia is prose and regulation only, not an axiom, and there is no realization link to the verification capability twin." ;
  rdfs:subClassOf bfo:0000015 . # Process

# Mirror the capability-layer disjointness (:BiometricIdentificationCapability owl:disjointWith
# :BiometricVerificationCapability, ARCO_core.ttl) at the process layer: verification is not
# identification, so the new :BiometricIdentificationProcess genus does not subsume it.
:BiometricVerificationProcess owl:disjointWith :BiometricIdentificationProcess .

:CreditworthinessEvaluationProcess rdf:type owl:Class ;
  rdfs:label "Creditworthiness Evaluation Process"@en ;
  skos:definition "A process that evaluates a person's creditworthiness or assigns a credit score."@en ;
  skos:scopeNote "The Gate-2 process kind for Annex III 5(b), evaluating the creditworthiness of natural persons or establishing their credit score, operative through Annex III item 5(b) under Article 6(2). 5(b) is self-contained: the Act gives no Article 3 definition of creditworthiness, so the differentia must not be pinned to any Article 3 article. Gate 2 is one of three independently necessary gates."@en ;
  rdfs:comment "Scoring or evaluating a person's credit standing, the regulated process for Annex III 5(b). Do not confuse it with benefits-eligibility scoring for public assistance (Annex III 5(a) territory, unmodeled). Gate 2 reaches it indirectly, through the :CreditworthinessEvaluationIntendedUseSpec subkind that prescribes it. The 5(b) fraud exception is not enforced here (no disjointness with :FraudDetectionProcess); the audit layer raises it for human review. The natural-person restriction is Gate 3's, not this process's." ;
  rdfs:subClassOf bfo:0000015 . # Process

:NaturalPersonRole rdf:type owl:Class ;
  rdfs:label "Natural Person Role"@en ;
  skos:definition "The role borne by an individual human being in virtue of their legal standing as a natural person, a rights-bearing individual distinct from a legal or juridical person such as a corporation."@en ;
  skos:scopeNote "ARCO's Gate-3 affected-population universal: a UseScenarioSpecification cco:designates this class (owl:hasValue) to satisfy Gate 3 of both Annex III 1(a) and 5(b). The link to the Act is operative, not definitional: 5(b) names natural persons directly and 1(a) reaches them through Article 3(41); the Act defines no natural person, the natural-versus-legal content coming from the general civil law it presupposes."@en ;
  rdfs:comment "A human being's legal standing as a natural person, as opposed to a juridical person such as a corporation. That contrast is the whole point of the class but carries no logical force: the only axiom is BFO Role, so to a reasoner this is indistinguishable from :ProviderRole or :DeployerRole, and nothing formal stops another role from being designated here. It fills Gate 3 for both Annex III categories, so it is necessary for either but does not separate 1(a) from 5(b) — the capability and process gates do that. Gate 3 names the role as a universal via cco:designates owl:hasValue, so no bearer-less token is minted; bearer-instance modeling is deferred (L2.4)." ;
  rdfs:subClassOf bfo:0000023 . # Role

:FraudDetectionProcess rdf:type owl:Class ;
  rdfs:label "Fraud Detection Process"@en ;
  skos:definition "A process whose purpose is detecting financial fraud."@en ;
  skos:scopeNote "Marks the fraud-detection exception to Annex III 5(b) (the carve-out for AI systems used for the purpose of detecting financial fraud), an exception to Article 6(2) high-risk applicability. The Act gives no Article 3 definition of financial fraud, so the term is legally undefined and the exception turns on human judgment of a system's primary purpose. Not a classification gate."@en ;
  rdfs:comment "A process kind ARCO uses only to flag the Annex III 5(b) fraud-detection exception in the audit layer; it changes no OWL classification. Whether a given system's purpose is fraud detection is a provider claim the ontology cannot verify. ARCO leaves the 5(b) fraud carve-out out of the reasoner, so a credit-and-fraud system is still entailed :AnnexIII5bApplicableSystem and the exclusion is a candidate for human legal review, not an automatic result. Its only wiring is flag_fraud_exclusion_candidate.sparql, which fires only after 5(b) applicability is entailed. It is deliberately not disjoint from :CreditworthinessEvaluationProcess, so nothing formal separates them; the fraud criterion lives only in prose." ;
  rdfs:subClassOf bfo:0000015 . # Process

:DerogationClaim rdf:type owl:Class ;
  rdfs:label "Derogation Claim"@en ;
  skos:definition "A provider-submitted claim that an AI system qualifies for the Article 6(3) derogation from high-risk classification. Recorded as documentation; the validity of the claim requires human legal review and is not evaluated by the ontology."@en ;
  rdfs:comment "PROVIDER-ASSERTED ARTIFACT. A descriptive ICE representing a provider's claim that their system qualifies for the Article 6(3) derogation ('shall not be considered to be high-risk where it does not pose a significant risk of harm'). This class is used by the audit-layer SPARQL flag only; it does NOT affect OWL classification. The ontology cannot evaluate whether a derogation claim is valid — that requires human legal judgment. When a DerogationClaim is_about a classified system, the audit layer emits a FLAGGED notice directing human review. NEVER use this class as a gate condition or in an equivalentClass axiom." ;
  rdfs:subClassOf cco:DescriptiveInformationContentEntity .

#################################################################
# 4b) COMPLIANCE OBLIGATION MODELING
#
# Who bears what: a ComplianceObligationSpecification is a
# directive ICE that links a system to the role responsible
# for fulfilling a regulatory requirement. This is the
# foundation for "provider must do X for system Y."
#
# No enforcement realization modeled yet — this captures
# the obligation artifact only.
#################################################################

:ComplianceObligationSpecification rdf:type owl:Class ;
  rdfs:label "Compliance Obligation Specification"@en ;
  skos:definition "A specification document identifying which compliance obligations a provider bears for a given AI system under specific regulatory content."@en ;
  rdfs:comment "A directive ICE specifying that a particular role-bearer has compliance obligations for a system. Aboutness links to the system and the responsible role." ;
  rdfs:subClassOf cco:DirectiveInformationContentEntity ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom :System
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom bfo:0000023  # Role (covers ProviderRole, DeployerRole)
  ] .

#################################################################
# 5) ANNEX III 1(a) ENTAILMENT CLASS
#
# OWL entailment-first classification: AnnexIII1aApplicableSystem
# membership is INFERRED by the reasoner when all three gates hold.
# Demonstrated under owlrl OWL-RL semantics; each gate is
# independently necessary (verified by test_gate_removal.py).
#
# Gate 1 (reality-side): System has_part some (SystemComponent
#         AND has_disposition some BiometricIdentificationCapability)
# Gate 2 (representation-side): An IntendedUseSpecification
#         is_about this system (via inverse of iao:0000136)
# Gate 3 (representation-side): A UseScenarioSpecification
#         is_about this system (via inverse of iao:0000136)
#
# This class represents statutory applicability (an institutional
# determination), not a change in the system's ontological kind.
# Directive ICEs participate because Annex III conditions on
# documented intended use ("intended to be used for..."); capability
# remains reality-side (disposition in components).
#
# Inverse aboutness uses anonymous inverse property expressions
# (OWL 2 DL expressible). Reasoner portability: owlrl materializes
# these; other reasoners may vary. SHACL qualified shapes and
# SPARQL ASK queries provide a fallback validation layer.
#
# Aboutness targets include class IRIs used as individuals (OWL 2
# punning), in two distinct uses with different load (see the design
# note at the top of this file): the traceability aboutness assertions
# are documentary — no classification entailment consumes them — while
# Gate 3's cco:designates owl:hasValue :NaturalPersonRole IS
# classification-load-bearing, consumed strictly in its individual
# interpretation; the class axioms on the same IRI play no role in the
# derivation.
#
# SPARQL checks are AUDIT ONLY — the classification is an
# OWL entailment, not a pattern match.
#################################################################

:AnnexIII1aApplicableSystem rdf:type owl:Class ;
  rdfs:label "Annex III 1(a) Applicable System"@en ;
  skos:definition "An AI system that satisfies all three gates for Annex III 1(a) (biometric identification): a component bearing a triggering capability, an intended use prescribing a remote biometric identification process, and a use scenario designating natural persons as the affected role."@en ;
  rdfs:comment """System that satisfies ARCO's three-gate encoding of Annex III 1(a) via three independently necessary gates:
    Gate 1 (reality-side): capability — system has_part a component that has_disposition BiometricIdentificationCapability.
    Gate 2 (representation-side): prescribed process — an IntendedUseSpecification is_about the system AND cco:prescribes some instance of :RemoteBiometricIdentificationProcess. Uses owl:someValuesFrom for genuine type-checking; any correctly typed process token satisfies the gate.
    Gate 3 (representation-side): affected role — a UseScenarioSpecification (a Designative ICE) is_about the system AND cco:designates :NaturalPersonRole. Uses owl:hasValue with the class IRI as a named individual (OWL 2 punning, DL-legal; the entailment consumes the IRI only in its individual interpretation). The individual is read as a proxy for the role category so the gate can reference the affected-role kind without minting a role-bearer particular for which no source warrant exists (L2.4; BFO Roles are bearer-dependent specifically dependent continuants). This category-designation reading is ARCO's documented intent, not canonical CCO usage; see LIMITATIONS §3.1.
  Classification is OWL-entailed under owlrl; gate independence verified by regression test (test_gate_removal.py).
  SPARQL ASK queries (check_intended_use, check_regulatory_alignment) are downstream audit-layer checks that inspect declared documentary content on the reasoned graph; they do not contribute to this entailment and cannot affect it. Encoding note: Gates 2 and 3 carry the Act's intended-use and affected-population conditions; Gate 1 (capability) is ARCO's design-time evidential addition, stricter than the Annex III text — absence of a capability assertion blocks entailment even when regulated intent is documented (under-classification direction; see LIMITATIONS §3.9).""" ;
  :hasRegulatoryBasis "Regulation (EU) 2024/1689, Annex III item 1(a); Article 6(2); Article 3(41) (remote biometric identification system definition); Article 3(36) (verification carve-out); Recitals 15 and 17"@en ;
  :hasRegulatoryBasis "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"^^xsd:anyURI ;
  skos:scopeNote "Defined class (not a universal): its instances are AI systems satisfying the three-gate defined-class axiom for Annex III 1(a); ARCO reports membership only as entailed under reviewed commitments. The partition criterion is the conjunction of the intended-use and use-scenario gates carried by Annex III item 1(a) with ARCO's added capability gate (LIMITATIONS §3.9) — a regulatory fiat boundary plus an ARCO-added capability condition (not part of the Annex III text; evidential in effect, since entailment requires a reviewed capability commitment), not a natural joint in the system space. Fiat/bona-fide boundary distinction used analogically per S3a: instances are real systems; the boundary that picks them out is determined by Regulation (EU) 2024/1689, not by a shared physical property."@en ;
  rdfs:subClassOf :System ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :System

      # Gate 1 (reality-side): biometric capability via component
      [ rdf:type owl:Restriction ;
        owl:onProperty bfo:0000051 ;                 # has_part
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :SystemComponent
            [ rdf:type owl:Restriction ;
              owl:onProperty ro:0000091 ;            # has_disposition
              owl:someValuesFrom :BiometricIdentificationCapability
            ]
          )
        ]
      ]

      # Gate 2 (representation-side): an :IntendedUseSpecification of the regulated subkind
      # is_about this system. The IUS subkind :RemoteBiometricIdentificationIntendedUseSpec
      # is itself defined by equivalentClass intersectionOf (IntendedUseSpec ⊓ prescribes
      # someValuesFrom :RemoteBiometricIdentificationProcess), so the type-check on the
      # prescribed process happens at the IUS subkind class level. This factoring mirrors
      # the CCO Specification family pattern (cco:ArtifactFunctionSpecification etc.).
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom :RemoteBiometricIdentificationIntendedUseSpec
      ]

      # Gate 3 (representation-side): scenario spec is_about this system AND cco:designates
      # :NaturalPersonRole. cco:designates declares NO range in the pinned CCO v1.7; the only
      # inherited range constraint is the parent cco:is_about's bfo:0000001. owl:hasValue uses
      # the class IRI as a named individual (OWL 2 punning, DL-legal; the entailment consumes
      # the IRI only in its individual interpretation), avoiding a role-bearer particular for
      # which no source warrant exists (L2.4; BFO Roles are bearer-dependent specifically
      # dependent continuants requiring ro:0000052 to an independent continuant). Category
      # designation is ARCO's documented intent, not a CCO-documented use — CCO's designates
      # examples all target particulars (LIMITATIONS §3.1).
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :UseScenarioSpecification
            [ rdf:type owl:Restriction ;
              owl:onProperty cco:designates ;
              owl:hasValue :NaturalPersonRole
            ]
          )
        ]
      ]
    )
  ] .

#################################################################
# 6) ANNEX III 5(b) ENTAILMENT CLASS
#
# Same three-gate schema as AnnexIII1aApplicableSystem.
# Validates that the pattern generalizes to a second genuinely
# distinct Annex III category (creditworthiness != biometrics).
#
# Gate 1 (reality-side): system has_part a SystemComponent that
#         has_disposition some CreditworthinessEvaluationCapability
# Gate 2 (representation-side): IntendedUseSpecification is_about
#         this system AND cco:prescribes a CreditworthinessEvaluationProcess
#         token — genuine type-check, same pattern as 1(a) Gate 2.
# Gate 3 (representation-side): UseScenarioSpecification is_about
#         this system AND cco:designates owl:hasValue :NaturalPersonRole
#         (class IRI as named individual; no role instance is minted or
#         required — encoding recorded at L2.4) — same pattern as 1(a) Gate 3.
#
# Conservative claim: demonstrates category extension for
# creditworthiness evaluation. The 5(b) fraud-detection carve-out
# and other 5(b) legal nuances are not modeled at this stage.
#################################################################

:AnnexIII5bApplicableSystem rdf:type owl:Class ;
  rdfs:label "Annex III 5(b) Applicable System"@en ;
  skos:definition "An AI system that satisfies all three gates for Annex III 5(b) (creditworthiness): a component bearing a triggering capability, an intended use prescribing a creditworthiness evaluation process, and a use scenario designating natural persons as the affected role."@en ;
  rdfs:comment """System satisfying ARCO's three-gate encoding of Annex III 5(b) via three independently necessary gates:
    Gate 1 (reality-side): capability — system has_part a component that has_disposition CreditworthinessEvaluationCapability.
    Gate 2 (representation-side): prescribed process — an IntendedUseSpecification is_about the system AND cco:prescribes some instance of :CreditworthinessEvaluationProcess. Same pattern as 1(a); any correctly typed process token satisfies the gate.
    Gate 3 (representation-side): affected role — a UseScenarioSpecification (a Designative ICE) is_about the system AND cco:designates :NaturalPersonRole. Same pattern as 1(a) Gate 3: owl:hasValue with the class IRI as a named individual (OWL 2 punning; the entailment consumes the IRI only in its individual interpretation); no role-bearer particular is minted (L2.4). This category-designation reading is ARCO's documented intent, not canonical CCO usage; see LIMITATIONS §3.1.
  Classification is OWL-entailed under owlrl.
  Conservative scope: demonstrates category extension; the fraud-detection carve-out and other 5(b) nuances remain deferred (audit-layer flag only, not a classification gate).
  Cross-category non-entailment: a system bearing only CreditworthinessEvaluationCapability is NOT entailed as AnnexIII1aApplicableSystem; a system bearing only BiometricIdentificationCapability is NOT entailed as AnnexIII5bApplicableSystem. (OWA — both claims hold under current assertions.) Encoding note: Gates 2 and 3 carry the Act's intended-use and affected-population conditions; Gate 1 (capability) is ARCO's design-time evidential addition, stricter than the Annex III text (under-classification direction; see LIMITATIONS §3.9).""" ;
  :hasRegulatoryBasis "Regulation (EU) 2024/1689, Annex III item 5(b); Article 6(2)"@en ;
  :hasRegulatoryBasis "https://eur-lex.europa.eu/eli/reg/2024/1689/oj"^^xsd:anyURI ;
  skos:scopeNote "Defined class (not a universal): its instances are AI systems satisfying the three-gate defined-class axiom for Annex III 5(b); ARCO reports membership only as entailed under reviewed commitments. The partition criterion is the conjunction of the intended-use and use-scenario gates carried by Annex III item 5(b) with ARCO's added capability gate (LIMITATIONS §3.9) — a regulatory fiat boundary plus an ARCO-added capability condition (not part of the Annex III text; evidential in effect, since entailment requires a reviewed capability commitment), not a natural joint in the system space. Fiat/bona-fide boundary distinction used analogically per S3a: instances are real systems; the boundary that picks them out is determined by Regulation (EU) 2024/1689, not by a shared physical property. Conservative scope: the fraud-detection carve-out (the single exception clause in Annex III 5(b)) is not modeled as a classification gate; it is disclosed at LIMITATIONS §2 and surfaced by the audit-layer flag query, and carve-out-as-OWL-consequence is deliberately held closed pending firm legal interpretation. Fiat-boundary annotation for the carve-out class is queued as X.14."@en ;
  rdfs:subClassOf :System ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :System

      # Gate 1 (reality-side): creditworthiness evaluation capability via component
      [ rdf:type owl:Restriction ;
        owl:onProperty bfo:0000051 ;                 # has_part
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :SystemComponent
            [ rdf:type owl:Restriction ;
              owl:onProperty ro:0000091 ;            # has_disposition
              owl:someValuesFrom :CreditworthinessEvaluationCapability
            ]
          )
        ]
      ]

      # Gate 2 (representation-side): an :IntendedUseSpecification of the regulated subkind
      # is_about this system. Same factoring as 1(a) Gate 2: the IUS subkind
      # :CreditworthinessEvaluationIntendedUseSpec is defined by equivalentClass intersectionOf
      # (IntendedUseSpec ⊓ prescribes someValuesFrom :CreditworthinessEvaluationProcess), so the
      # type-check on the prescribed process happens at the IUS subkind class level.
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom :CreditworthinessEvaluationIntendedUseSpec
      ]

      # Gate 3 (representation-side): scenario spec is_about this system AND cco:designates
      # :NaturalPersonRole. Same pattern as 1(a) Gate 3: owl:hasValue uses the class IRI as a
      # named individual (OWL 2 punning; the entailment consumes the IRI only in its individual
      # interpretation); no role-bearer particular is minted (L2.4). Category designation is
      # ARCO's documented intent, not a CCO-documented use (LIMITATIONS §3.1).
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :UseScenarioSpecification
            [ rdf:type owl:Restriction ;
              owl:onProperty cco:designates ;
              owl:hasValue :NaturalPersonRole
            ]
          )
        ]
      ]
    )
  ] .

# Relation labels (has role, inheres in) are declared in ARCO_core.ttl.
