@prefix :    <https://arco.ai/ontology/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix ro:  <http://purl.obolibrary.org/obo/RO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://arco.ai/ontology/governance>
a owl:Ontology ;
rdfs:label "ARCO Governance Extension — Entailment-First Regulatory Classification" ;
rdfs:comment "Governance, intended use, and regulatory classification layer. AnnexIII1aApplicableSystem is OWL-entailed from three gates: capability + intended use + use scenario. Demonstrated under owlrl." ;
owl:versionInfo "Foundational ontology alignment: BFO 2020 (ISO/IEC 21838-2:2021) via OBO namespace http://purl.obolibrary.org/obo/BFO_. CCO terms (Organization, DirectiveInformationContentEntity, DescriptiveInformationContentEntity, prescribes, has_output, Person) declared as local stubs using IRI namespace http://www.ontologyrepository.com/CommonCoreOntologies/ (pre-integrated-release, exact version unverified). Full CCO import is not required; only the specific terms used are declared." ;
owl:imports <https://arco.ai/ontology/core> .
# NOTE: owl:imports references the core ontology IRI. rdflib does not follow
# owl:imports automatically; all TTL files are loaded explicitly by the pipeline.
# Tools that do follow owl:imports will need a local catalog or network access.

# Design Decisions (frozen — do not change without explicit justification):
#
#   Inverse aboutness: AnnexIII1aApplicableSystem uses anonymous inverse
#   property expressions [owl:inverseOf iao:0000136] in its equivalentClass
#   axiom. This is OWL 2 DL expressible. owlrl materializes it correctly.
#   SHACL qualified shapes + SPARQL ASK queries provide fallback validation
#   if a different reasoner does not materialize inverse restrictions.
#
#   OWL 2 punning: iao:0000136 (is_about) targets class IRIs as individuals
#   in traceability assertions (e.g., condition is_about BiometricCapability).
#   This is permitted in OWL 2 but the IRI is interpreted separately as class
#   and individual. No classification entailment depends on punning — it is
#   used for audit/traceability only.
#
#   Class-level restrictions are general: IntendedUseSpecification prescribes
#   some Process (not a specific process); UseScenarioSpecification is_about
#   some Role (not a specific role). Annex III category specifics belong on
#   instances, keeping the schema extensible to 1(b), 1(c), etc.


#################################################################
# 1) ACTORS + ROLES
#################################################################

:ProviderOrganization rdf:type owl:Class ;
  rdfs:label "Provider Organization" ;
  rdfs:subClassOf cco:Organization ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ro:0000087 ;   # has role
    owl:someValuesFrom :ProviderRole
  ] .

:ProviderRole rdf:type owl:Class ;
  rdfs:label "Provider Role" ;
  rdfs:subClassOf bfo:0000023 .   # Role

:DeployerRole rdf:type owl:Class ;
  rdfs:label "Deployer Role" ;
  rdfs:comment "Role borne by an entity that deploys an AI system. Distinct from provider (who develops/places on market)." ;
  rdfs:subClassOf bfo:0000023 .   # Role

#################################################################
# 2) DOCUMENTATION WORKFLOW
#################################################################

:AssessmentDocumentationProcess rdf:type owl:Class ;
  rdfs:label "Assessment Documentation Process" ;
  rdfs:subClassOf bfo:0000015 ; # Process
  rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ro:0000057 ; owl:someValuesFrom :System ] ,
    [ a owl:Restriction ; owl:onProperty ro:0000057 ; owl:someValuesFrom :ProviderOrganization ] ,
    [ a owl:Restriction ; owl:onProperty cco:has_output ; owl:someValuesFrom :AssessmentDocumentation ] .

:AssessmentDocumentation rdf:type owl:Class ;
  rdfs:label "Assessment Documentation" ;
  rdfs:comment "A documentation artifact produced by the assessment documentation process; traceable to the assessed system and the regulatory content applied." ;
  rdfs:subClassOf :InformationOutput ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;  # is about
    owl:someValuesFrom :System
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;  # is about
    owl:someValuesFrom :RegulatoryContent
  ] .

#################################################################
# 3) CCO DECLARATIONS (local stubs — no full import)
#################################################################

cco:DirectiveInformationContentEntity rdf:type owl:Class ;
  rdfs:label "Directive Information Content Entity" ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

cco:DescriptiveInformationContentEntity rdf:type owl:Class ;
  rdfs:label "Descriptive Information Content Entity" ;
  rdfs:comment "ICE that describes or reports states of affairs. Examples: compliance determinations, assessment documentation, operational outputs. Contrast with DirectiveInformationContentEntity (prescribes behavior)." ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

# Three D's subtyping — map existing ARCO ICE classes to directive/descriptive.
:RegulatoryContent rdfs:subClassOf cco:DirectiveInformationContentEntity .
:InformationOutput rdfs:subClassOf cco:DescriptiveInformationContentEntity .
:ComplianceDetermination rdfs:subClassOf cco:DescriptiveInformationContentEntity .

cco:prescribes rdf:type owl:ObjectProperty ;
  rdfs:label "prescribes" ;
  rdfs:comment "A directive ICE prescribes a process type as a rule or guide. Domain: DirectiveInformationContentEntity. Range: Process (bfo:0000015 subclass)." .

cco:has_output rdf:type owl:ObjectProperty ;
  rdfs:label "has output" .

cco:Person rdf:type owl:Class ;
  rdfs:label "Person" ;
  rdfs:subClassOf bfo:0000040 . # Material Entity

cco:Organization rdf:type owl:Class ;
  rdfs:label "Organization" ;
  rdfs:subClassOf bfo:0000027 . # Object Aggregate

#################################################################
# 3b) REGULATORY BRIDGE AXIOMS
#
# AnnexIIITriggeringCapability is a REGULATORY GROUPING CLASS,
# not a BFO natural kind. There is no mind-independent property
# shared by all triggering capabilities in reality — what makes
# a capability "triggering" is the legal text of Annex III.
# It is a defined class grouping capability universals by their
# legal relevance. It lives here (regulatory domain layer), not
# in core.
#
# Direct subclassing replaces the prior one-member union:
#   BiometricIdentificationCapability rdfs:subClassOf AnnexIIITriggeringCapability
# This is semantically equivalent for current cases and scales
# cleanly: each new Annex III capability category adds a subclass
# assertion here, with no edits to core.
#
# HighRiskSystem is also a regulatory determination concept.
# Its bridge axiom depends on AnnexIIITriggeringCapability and
# belongs in this layer.
#################################################################

:AnnexIIITriggeringCapability rdf:type owl:Class ;
  rdfs:label "Annex III Triggering Capability" ;
  rdfs:comment "Regulatory grouping class (not a BFO natural kind). Groups capability dispositions whose presence in a system component triggers Annex III applicability under the EU AI Act. New Annex III capability categories extend this by direct subclassing, not by editing a union axiom." ;
  rdfs:subClassOf :CapabilityDisposition .

# Direct subclassing: biometric identification IS one kind of Annex III triggering capability.
:BiometricIdentificationCapability rdfs:subClassOf :AnnexIIITriggeringCapability .

# Direct subclassing: creditworthiness evaluation IS a second kind of Annex III triggering capability.
# BiometricVerificationCapability is NOT subclassed here — 1:1 verification does not trigger Annex III.
:CreditworthinessEvaluationCapability rdfs:subClassOf :AnnexIIITriggeringCapability .

:HighRiskSystem rdf:type owl:Class ;
  rdfs:label "High-Risk AI System" ;
  rdfs:comment "A system classified as high-risk by virtue of having a SystemComponent that bears a disposition triggering Annex III. This class membership is INFERRED by the reasoner. Gate structure mirrors the category-specific classes (requires SystemComponent in the has_part chain)." ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :System
      [ rdf:type owl:Restriction ;
        owl:onProperty bfo:0000051 ;   # has part
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :SystemComponent
            [ rdf:type owl:Restriction ;
              owl:onProperty ro:0000091 ;  # has disposition
              owl:someValuesFrom :AnnexIIITriggeringCapability
            ]
          )
        ]
      ]
    )
  ] .

#################################################################
# 4) INTENDED USE MODELING (CCO Directive ICE Pattern)
#
# Annex III: "AI systems intended to be used for [process] of
# [affected entities]". Three-gate classification:
#   Gate 1: Capability (reality-side disposition)
#   Gate 2: Intended use (directive ICE prescribes process type)
#   Gate 3: Use scenario (affected entities)
#################################################################

:IntendedUseSpecification rdf:type owl:Class ;
  rdfs:label "Intended Use Specification" ;
  rdfs:comment "A directive ICE that prescribes the process type an AI system is intended to realize. Class-level restrictions enforce that it prescribes some Process and is about some System. The specific process type (e.g., biometric identification) is on the instance, not the class." ;
  rdfs:subClassOf cco:DirectiveInformationContentEntity ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cco:prescribes ;
    owl:someValuesFrom bfo:0000015   # Process (general — instance carries specifics)
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom :System
  ] .

:UseScenarioSpecification rdf:type owl:Class ;
  rdfs:label "Use Scenario Specification" ;
  rdfs:comment "A directive ICE that constrains the realization context: who/what is affected. Class-level restrictions enforce aboutness to some System and some Role. The specific affected role (e.g., NaturalPersonRole) is on the instance, not the class." ;
  rdfs:subClassOf cco:DirectiveInformationContentEntity ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom :System
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom bfo:0000023  # Role (general — instance carries specifics)
  ] .

:RemoteBiometricIdentificationProcess rdf:type owl:Class ;
  rdfs:label "Remote Biometric Identification Process" ;
  rdfs:comment "1:N biometric identification process regulated under Annex III 1(a). Has a real causal core (biometric feature extraction + matching at distance) but its type-boundary is partly constituted by regulatory fiat. Modeled as a BFO Process subclass; used as the Gate 2 type-check target for AnnexIII1aApplicableSystem." ;
  rdfs:subClassOf bfo:0000015 . # Process

:BiometricVerificationProcess rdf:type owl:Class ;
  rdfs:label "Biometric Verification Process" ;
  rdfs:comment "1:1 biometric verification process. Confirms a claimed identity against a single reference. NOT RemoteBiometricIdentificationProcess — verification is not a subtype of identification. NOT regulated under Annex III 1(a)." ;
  rdfs:subClassOf bfo:0000015 . # Process

:CreditworthinessEvaluationProcess rdf:type owl:Class ;
  rdfs:label "Creditworthiness Evaluation Process" ;
  rdfs:comment "Process of evaluating the creditworthiness of natural persons or establishing their credit score for access to financial or public services. Regulated under Annex III 5(b). Used as the Gate 2 type-check target for AnnexIII5bApplicableSystem." ;
  rdfs:subClassOf bfo:0000015 . # Process

:NaturalPersonRole rdf:type owl:Class ;
  rdfs:label "Natural Person Role" ;
  rdfs:comment "Legal designation under EU law. Not a biological kind — modeled as a BFO Role." ;
  rdfs:subClassOf bfo:0000023 . # Role

:FraudDetectionProcess rdf:type owl:Class ;
  rdfs:label "Fraud Detection Process" ;
  rdfs:comment "Process whose primary purpose is detecting financial fraud. Relevant to the 5(b) fraud exclusion (Annex III 5(b) second clause: 'with the exception of AI systems used for the purpose of detecting financial fraud'). A system whose IntendedUseSpecification prescribes a FraudDetectionProcess token — and which is also classified as AnnexIII5bApplicableSystem — may qualify for the fraud exclusion. This class is used by the audit-layer SPARQL flag only; it does not participate in any OWL gate condition. Provider-declared: this classification cannot be verified by the ontology." ;
  rdfs:subClassOf bfo:0000015 . # Process

:DerogationClaim rdf:type owl:Class ;
  rdfs:label "Derogation Claim" ;
  rdfs:comment "PROVIDER-ASSERTED ARTIFACT. A descriptive ICE representing a provider's claim that their system qualifies for the Article 6(3) derogation ('shall not be considered to be high-risk where it does not pose a significant risk of harm'). This class is used by the audit-layer SPARQL flag only; it does NOT affect OWL classification. The ontology cannot evaluate whether a derogation claim is valid — that requires human legal judgment. When a DerogationClaim is_about a classified system, the audit layer emits a FLAGGED notice directing human review. NEVER use this class as a gate condition or in an equivalentClass axiom." ;
  rdfs:subClassOf cco:DescriptiveInformationContentEntity .

#################################################################
# 4b) COMPLIANCE OBLIGATION MODELING
#
# Who bears what: a ComplianceObligationSpecification is a
# directive ICE that links a system to the role responsible
# for fulfilling a regulatory requirement. This is the
# foundation for "provider must do X for system Y."
#
# No enforcement realization modeled yet — this captures
# the obligation artifact only.
#################################################################

:ComplianceObligationSpecification rdf:type owl:Class ;
  rdfs:label "Compliance Obligation Specification" ;
  rdfs:comment "A directive ICE specifying that a particular role-bearer has compliance obligations for a system. Aboutness links to the system and the responsible role." ;
  rdfs:subClassOf cco:DirectiveInformationContentEntity ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom :System
  ] ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty iao:0000136 ;   # is about
    owl:someValuesFrom bfo:0000023  # Role (covers ProviderRole, DeployerRole)
  ] .

#################################################################
# 5) ANNEX III 1(a) ENTAILMENT CLASS
#
# OWL entailment-first classification: AnnexIII1aApplicableSystem
# membership is INFERRED by the reasoner when all three gates hold.
# Demonstrated under owlrl OWL-RL semantics; each gate is
# independently necessary (verified by test_gate_removal.py).
#
# Gate 1 (reality-side): System has_part some (SystemComponent
#         AND has_disposition some BiometricIdentificationCapability)
# Gate 2 (representation-side): An IntendedUseSpecification
#         is_about this system (via inverse of iao:0000136)
# Gate 3 (representation-side): A UseScenarioSpecification
#         is_about this system (via inverse of iao:0000136)
#
# This class represents statutory applicability (an institutional
# determination), not a change in the system's ontological kind.
# Directive ICEs participate because Annex III conditions on
# documented intended use ("intended to be used for..."); capability
# remains reality-side (disposition in components).
#
# Inverse aboutness uses anonymous inverse property expressions
# (OWL 2 DL expressible). Reasoner portability: owlrl materializes
# these; other reasoners may vary. SHACL qualified shapes and
# SPARQL ASK queries provide a fallback validation layer.
#
# Aboutness targets include class IRIs used as individuals (OWL 2
# punning). This is permitted in OWL 2 but means the IRI is
# interpreted separately as a class and as an individual. We do
# not rely on punning for core classification entailments — it is
# used for traceability and audit only.
#
# SPARQL checks are AUDIT ONLY — the classification is an
# OWL entailment, not a pattern match.
#################################################################

:AnnexIII1aApplicableSystem rdf:type owl:Class ;
  rdfs:label "Annex III 1(a) Applicable System" ;
  rdfs:comment """System that meets Annex III 1(a) conditions via three independently necessary gates:
    Gate 1 (reality-side): capability — system has_part a component that has_disposition BiometricIdentificationCapability.
    Gate 2 (representation-side): prescribed process — an IntendedUseSpecification is_about the system AND cco:prescribes some instance of :RemoteBiometricIdentificationProcess. Uses owl:someValuesFrom for genuine type-checking; any correctly typed process token satisfies the gate.
    Gate 3 (representation-side): affected role — a UseScenarioSpecification is_about the system AND iao:is_about :NaturalPersonRole. Uses owl:hasValue intentionally: the scenario spec is about the role CATEGORY (the universal), not a specific role-bearer token. Referencing the class IRI as concept-individual is the correct OWL 2 encoding for this regulatory pattern.
  Classification is OWL-entailed under owlrl; gate independence verified by regression test (test_gate_removal.py).
  SPARQL ASK queries (check_intended_use, check_regulatory_alignment) are downstream audit-layer checks that inspect declared documentary content on the reasoned graph; they do not contribute to this entailment and cannot affect it.""" ;
  rdfs:subClassOf :System ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :System

      # Gate 1 (reality-side): biometric capability via component
      [ rdf:type owl:Restriction ;
        owl:onProperty bfo:0000051 ;                 # has_part
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :SystemComponent
            [ rdf:type owl:Restriction ;
              owl:onProperty ro:0000091 ;            # has_disposition
              owl:someValuesFrom :BiometricIdentificationCapability
            ]
          )
        ]
      ]

      # Gate 2 (representation-side): intended use spec is_about this system AND prescribes an
      # instance of the regulated process class for Annex III 1(a). cco:prescribes carries the
      # statutory prescriptive force. owl:someValuesFrom :RemoteBiometricIdentificationProcess
      # performs genuine type-checking: any named individual typed as that class satisfies the gate.
      # This eliminates the false-negative risk of the prior owl:hasValue pattern (which only matched
      # the class IRI as a punned individual, not correctly-typed process tokens).
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :IntendedUseSpecification
            [ rdf:type owl:Restriction ;
              owl:onProperty cco:prescribes ;
              owl:someValuesFrom :RemoteBiometricIdentificationProcess
            ]
          )
        ]
      ]

      # Gate 3 (representation-side): scenario spec is_about this system AND is_about the relevant
      # affected role for Annex III 1(a). owl:hasValue is intentional here (not interim debt):
      # the scenario spec is about the NaturalPersonRole CATEGORY (the universal), not a specific
      # role-bearer instance (which would require a specific individual at a specific time).
      # Referencing the class IRI as a concept-individual is the correct OWL 2 encoding for
      # "this scenario addresses the regulated role type."
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :UseScenarioSpecification
            [ rdf:type owl:Restriction ;
              owl:onProperty iao:0000136 ;
              owl:hasValue :NaturalPersonRole
            ]
          )
        ]
      ]
    )
  ] .

#################################################################
# 6) ANNEX III 5(b) ENTAILMENT CLASS
#
# Same three-gate schema as AnnexIII1aApplicableSystem.
# Validates that the pattern generalizes to a second genuinely
# distinct Annex III category (creditworthiness != biometrics).
#
# Gate 1 (reality-side): system has_part a SystemComponent that
#         has_disposition some CreditworthinessEvaluationCapability
# Gate 2 (representation-side): IntendedUseSpecification is_about
#         this system AND cco:prescribes a CreditworthinessEvaluationProcess
#         token — genuine type-check, mirrors the corrected 1(a) Gate 2.
# Gate 3 (representation-side): UseScenarioSpecification is_about
#         this system AND is_about :NaturalPersonRole (the universal).
#
# Conservative claim: demonstrates category extension for
# creditworthiness evaluation. Micro-enterprise exclusions and
# other 5(b) legal nuances are not modeled at this stage.
#################################################################

:AnnexIII5bApplicableSystem rdf:type owl:Class ;
  rdfs:label "Annex III 5(b) Applicable System" ;
  rdfs:comment """System meeting Annex III 5(b) conditions via three independently necessary gates:
    Gate 1 (reality-side): capability — system has_part a component that has_disposition CreditworthinessEvaluationCapability.
    Gate 2 (representation-side): prescribed process — an IntendedUseSpecification is_about the system AND cco:prescribes some instance of :CreditworthinessEvaluationProcess. Mirrors the corrected 1(a) pattern; any correctly typed process token satisfies the gate.
    Gate 3 (representation-side): affected role — a UseScenarioSpecification is_about the system AND iao:is_about :NaturalPersonRole (the role category, not a bearer instance).
  Classification is OWL-entailed under owlrl.
  Conservative scope: demonstrates category extension; micro-enterprise exclusions and other 5(b) nuances remain deferred.
  Cross-category non-entailment: a system bearing only CreditworthinessEvaluationCapability is NOT entailed as AnnexIII1aApplicableSystem; a system bearing only BiometricIdentificationCapability is NOT entailed as AnnexIII5bApplicableSystem. (OWA — both claims hold under current assertions.)""" ;
  rdfs:subClassOf :System ;
  owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
      :System

      # Gate 1 (reality-side): creditworthiness evaluation capability via component
      [ rdf:type owl:Restriction ;
        owl:onProperty bfo:0000051 ;                 # has_part
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :SystemComponent
            [ rdf:type owl:Restriction ;
              owl:onProperty ro:0000091 ;            # has_disposition
              owl:someValuesFrom :CreditworthinessEvaluationCapability
            ]
          )
        ]
      ]

      # Gate 2 (representation-side): intended use spec is_about this system AND prescribes a
      # CreditworthinessEvaluationProcess token. owl:someValuesFrom performs genuine type-checking;
      # any correctly typed process token satisfies the gate. Mirrors the corrected 1(a) Gate 2.
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :IntendedUseSpecification
            [ rdf:type owl:Restriction ;
              owl:onProperty cco:prescribes ;
              owl:someValuesFrom :CreditworthinessEvaluationProcess
            ]
          )
        ]
      ]

      # Gate 3 (representation-side): scenario spec is_about this system AND is_about the
      # NaturalPersonRole universal. owl:hasValue intentional: same reasoning as 1(a) Gate 3 —
      # creditworthiness evaluation targets the role CATEGORY, not a specific role-bearer.
      [ rdf:type owl:Restriction ;
        owl:onProperty [ rdf:type owl:ObjectProperty ; owl:inverseOf iao:0000136 ] ;
        owl:someValuesFrom [
          rdf:type owl:Class ;
          owl:intersectionOf (
            :UseScenarioSpecification
            [ rdf:type owl:Restriction ;
              owl:onProperty iao:0000136 ;
              owl:hasValue :NaturalPersonRole
            ]
          )
        ]
      ]
    )
  ] .

# Relation labels (has role, inheres in) are declared in ARCO_core.ttl.
