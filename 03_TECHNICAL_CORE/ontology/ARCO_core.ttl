@prefix :    <https://arco.ai/ontology/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix ro:  <http://purl.obolibrary.org/obo/RO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos:<http://www.w3.org/2004/02/skos/core#> .

<https://arco.ai/ontology/core> rdf:type owl:Ontology ;
  rdfs:label "ARCO Core (Gold Standard) — BFO/RO Aligned"@en ;
  rdfs:comment "Core ontology with OWL restrictions for computable reasoning, with ICE-to-reality grounding via IAO is_about following BFO realist conventions. Uses ro:0000091 (has_disposition) per RO best practices." ;
  owl:versionInfo "Foundational ontology alignment: BFO 2020 (ISO/IEC 21838-2:2021) loaded as full upstream file from 03_TECHNICAL_CORE/ontology/imports/bfo-2020.owl. OBO Relations Ontology (RO) release 2025-12-17, IAO release 2026-03-30, and CCO release v1.7-2024-11-03 are loaded as ROBOT BOT-extracted slim modules per the OBO Foundry / ODK standard pattern, from imports/ro_bot.owl, imports/iao_bot.owl, and imports/cco_bot.owl respectively. Seed term lists are version-controlled at 03_TECHNICAL_CORE/ontology/imports/seeds/. See README 'Foundational ontology versions' for the full table." ;
  owl:imports <../ontology/imports/bfo-2020.owl> .
# NOTE: owl:imports uses a filesystem-relative path. rdflib does not follow
# owl:imports automatically; BFO is loaded explicitly by load_union_graph().
# Protégé and similar tools will resolve this correctly provided the repo
# directory structure is intact. If the file is moved, this path breaks silently.

# Design Decisions (rationale for the choices below):
#
#   System ⊑ ObjectAggregate: models the system as a structured aggregate
#   of material components. Defensible for component-level disposition
#   tracing. If a future system has stronger functional unity, revisit.
#
#   CapabilityDisposition ⊑ Disposition (not Function): Function would
#   require design-intent evidence we do not model yet. Disposition is
#   correct; Function is a future precision upgrade.
#
#   HighRiskSystem and AnnexIIITriggeringCapability live in the governance
#   extension, not here. Core contains only reality-side universals.
#   AnnexIII1aApplicableSystem: full three-gate (capability + intent +
#   scenario). Defined in governance extension.

#################################################################
# 1) REALITY-SIDE UNIVERSALS (BFO)
#
# Design Decision: We use ro:0000091 (has_disposition) rather than
# ro:0000053 (bearer_of) because:
#   - has_disposition is more specific in the RO property hierarchy
#   - has_disposition has domain: independent continuant, range: disposition
#   - bearer_of is generic (covers qualities, roles, functions, dispositions)
#   - This aligns with OBO Foundry best practices
#################################################################

:System rdf:type owl:Class ;
  rdfs:label "AI System"@en ;
  skos:definition "An object aggregate of one or more material components, used in ARCO as the assessment target for EU AI Act Annex III gates. The class itself does not formally restrict to AI; the AI scope is supplied by the use case and by the disposition kinds the components bear."@en ;
  rdfs:subClassOf bfo:0000027 ; # Object Aggregate
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty bfo:0000051 ; # has part
    owl:someValuesFrom :SystemComponent
  ] .

:SystemComponent rdf:type owl:Class ;
  rdfs:label "System Component"@en ;
  skos:definition "A material part of an AI system. Software is not a system component; it is information content that runs on hardware."@en ;
  rdfs:comment "Material component of an AI system (bfo:Object). Software is NOT a SystemComponent — it is an ICE (see SoftwareArtifact). has_part between an ObjectAggregate and an ICE would be a BFO category error." ;
  rdfs:subClassOf bfo:0000030 . # Object

:HardwareComponent rdf:type owl:Class ;
  rdfs:label "Hardware Component"@en ;
  skos:definition "A physical part of an AI system, such as a sensor module, processor, or integrated unit, that bears the system's capabilities."@en ;
  rdfs:subClassOf :SystemComponent ;
  rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty ro:0000091 ; # has disposition (RO-specific)
    owl:someValuesFrom :CapabilityDisposition
  ] .

:CapabilityDisposition rdf:type owl:Class ;
  rdfs:label "AI Capability Disposition"@en ;
  skos:definition "A disposition borne by a system component whose realization is the component participating in a process that produces the capability's output. ARCO subclasses this to enumerate capability kinds named by Annex III (biometric identification, creditworthiness evaluation, and others)."@en ;
  rdfs:subClassOf bfo:0000016 . # Disposition

:BiometricIdentificationCapability rdf:type owl:Class ;
  rdfs:label "Biometric Identification Capability"@en ;
  skos:definition "The capability to identify an unknown person from biometric data by comparing a sample against many candidates (one-to-many matching). Triggers Annex III 1(a)."@en ;
  rdfs:comment "1:N biometric identification capability. Realizations identify an unknown individual against a population database. Triggers Annex III 1(a). NOT the same as 1:1 verification (see BiometricVerificationCapability)." ;
  rdfs:subClassOf :CapabilityDisposition .

:BiometricVerificationCapability rdf:type owl:Class ;
  rdfs:label "Biometric Verification Capability"@en ;
  skos:definition "The capability to confirm a claimed identity by comparing biometric data against a single reference (one-to-one matching). Out of scope of Annex III 1(a) per Article 3(36)."@en ;
  rdfs:comment "1:1 biometric verification capability. Realizations confirm whether a presented individual matches a claimed identity. NOT subClassOf BiometricIdentificationCapability — verification is not a species of identification. NOT in AnnexIIITriggeringCapability. Does not trigger Annex III 1(a)." ;
  rdfs:subClassOf :CapabilityDisposition .

:CreditworthinessEvaluationCapability rdf:type owl:Class ;
  rdfs:label "Creditworthiness Evaluation Capability"@en ;
  skos:definition "The capability to evaluate a person's creditworthiness or assign a credit score for access to financial or public services. Triggers Annex III 5(b)."@en ;
  rdfs:comment "Capability to evaluate creditworthiness of natural persons or establish their credit score, for access to financial or public services. Reality-side disposition (the hardware genuinely has this capacity). Regulatory grouping (AnnexIIITriggeringCapability) is asserted in the governance extension. Triggers Annex III 5(b)." ;
  rdfs:subClassOf :CapabilityDisposition .

# Pairwise disjointness: these are genuinely different capability kinds.
# A component cannot simultaneously bear biometric identification AND
# creditworthiness evaluation as the SAME disposition. Prevents mis-typing.
:BiometricIdentificationCapability owl:disjointWith :BiometricVerificationCapability .
:BiometricIdentificationCapability owl:disjointWith :CreditworthinessEvaluationCapability .
:BiometricVerificationCapability owl:disjointWith :CreditworthinessEvaluationCapability .

:OperationalProcess rdf:type owl:Class ;
  rdfs:label "Operational Process"@en ;
  skos:definition "A process in which an AI system realizes one or more of its capabilities at deployment."@en ;
  rdfs:subClassOf bfo:0000015 ; # Process
  rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ro:0000057 ; owl:someValuesFrom :System ] ,                 # has participant
    [ a owl:Restriction ; owl:onProperty bfo:0000055 ; owl:someValuesFrom :CapabilityDisposition ] . # realizes

#################################################################
# 2) REPRESENTATION-SIDE UNIVERSALS (IAO)
#################################################################

:SoftwareArtifact rdf:type owl:Class ;
  rdfs:label "Software Artifact"@en ;
  skos:definition "Software content (model weights, code, configuration) used by an AI system. Modeled as information content rather than a physical part, so dispositions inhere in the hardware that runs the software."@en ;
  rdfs:comment "Software as a generically dependent continuant (ICE). Dispositions inhere in the material bearer that concretizes the software, not in the software artifact itself. Software relates to systems via concretization in material components, not via parthood. Do not type software as SystemComponent." ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

:InformationOutput rdf:type owl:Class ;
  rdfs:label "Information Output"@en ;
  skos:definition "An information artifact produced as the output of a process, such as an assessment report or a determination record."@en ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

:RegulatoryContent rdf:type owl:Class ;
  rdfs:label "Regulatory Content"@en ;
  skos:definition "An information artifact representing a passage of regulatory text, such as an Annex III item or a specific Article condition."@en ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

:ComplianceDetermination rdf:type owl:Class ;
  rdfs:label "Compliance Determination Result"@en ;
  skos:definition "A Descriptive Information Content Entity (ICE) that records the outcome of an ARCO entailment about a specific AI system — for example, an applicability entailment under a particular Annex III category, a latent-risk capability-precondition flag, or a non-applicability finding. This class is the parent ICE class for ARCO-side records of entailment outcomes; it is distinguished from a legal determination by a regulator or conformity assessment body under EU AI Act Articles 16-29, which the ontology does not produce."@en ;
  rdfs:comment "ICE-vs-reality cut: a ComplianceDetermination is a representation-side record of what ARCO entailed about a system, not the entailment itself and not a change in the system's ontological kind. It is also NOT a legal determination by a regulator or conformity assessment body under EU AI Act Articles 16-29 — those are produced by competent authorities under the Act's procedural framework, not by ARCO. Subclasses (e.g., :HighRiskDetermination) refine the kind of entailment recorded." ;
  rdfs:subClassOf iao:0000030 . # Information Content Entity

:HighRiskDetermination rdf:type owl:Class ;
  rdfs:label "High-Risk Determination"@en ;
  skos:definition "A Compliance Determination ICE that records either (a) the latent-risk capability-precondition flag entailment (membership in :HighRiskSystem, fired by Gate 1 alone — an Annex III triggering capability is borne by a system component), or (b) a category-specific Annex III applicability entailment (e.g., membership in :AnnexIII1aApplicableSystem or :AnnexIII5bApplicableSystem, fired by all three gates: capability, prescribed process, and affected role). The IRI is retained for backward compatibility. This class is NOT equivalent to a legal high-risk determination by a regulator or conformity assessment body under EU AI Act Articles 16-29."@en ;
  rdfs:comment "The IRI is retained for backward compatibility. This class is a Descriptive ICE recording an ARCO entailment (latent-risk flag from Gate 1, or three-gate Annex III applicability) and is NOT equivalent to a legal high-risk determination by a regulator or conformity assessment body under EU AI Act Articles 16-29. The bifurcation between (a) the Gate-1-only latent-risk flag (HighRiskSystem) and (b) the three-gate category-specific applicability entailments (AnnexIII1aApplicableSystem, AnnexIII5bApplicableSystem) is recorded by the certificate's PRIMARY vs. LATENT-RISK FLAG split; this class is the ICE container for either kind of record." ;
  rdfs:subClassOf :ComplianceDetermination .

#################################################################
# 3) BRIDGE AXIOMS — moved to governance extension
#
# AnnexIIITriggeringCapability and HighRiskSystem are defined in
# ARCO_governance_extension.ttl. They reference regulatory grouping
# concepts and belong in the regulatory domain layer, not core.
#################################################################

#################################################################
# 4) RELATION ANCHORS (labels for UI/debugging)
#################################################################

# BFO classes
bfo:0000015 rdfs:label "Process" .
bfo:0000016 rdfs:label "Disposition" .
bfo:0000023 rdfs:label "Role" .
bfo:0000027 rdfs:label "Object Aggregate" .
bfo:0000030 rdfs:label "Object" .
bfo:0000040 rdfs:label "Material Entity" .

# BFO relations
bfo:0000050 rdfs:label "part of" .
bfo:0000051 rdfs:label "has part" .
bfo:0000055 rdfs:label "realizes" .

# RO relations
ro:0000052 rdfs:label "inheres in" .
ro:0000053 rdfs:label "bearer of" .
ro:0000057 rdfs:label "has participant" .
ro:0000087 rdfs:label "has role" .
ro:0000091 rdfs:label "has disposition" .

# IAO relations
iao:0000136 rdfs:label "is about" .
