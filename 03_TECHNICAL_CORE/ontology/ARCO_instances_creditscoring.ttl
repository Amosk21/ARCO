@prefix :    <https://arco.ai/ontology/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix ro:  <http://purl.obolibrary.org/obo/RO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://arco.ai/ontology/instances/creditscoring> rdf:type owl:Ontology ;
  rdfs:label "ARCO Credit Scoring Instances — Annex III 5(b)" ;
  rdfs:comment """Demonstrates Annex III 5(b) classification for a creditworthiness evaluation system using the same three-gate schema as Annex III 1(a).

  CreditScorer_001 is entailed as AnnexIII5bApplicableSystem and HighRiskSystem by the OWL-RL reasoner.

  Cross-category non-entailment (OWA):
    - CreditScorer_001 is NOT entailed as AnnexIII1aApplicableSystem (no biometric identification capability; Gate 1 of 1(a) fails).
    - Sentinel_ID_System (from instances_sentinel.ttl) is NOT entailed as AnnexIII5bApplicableSystem (no creditworthiness capability; Gate 1 of 5(b) fails).

  Conservative scope: demonstrates category extension for creditworthiness evaluation. Micro-enterprise exclusions and other 5(b) nuances are not modeled at this stage.""" ;
  owl:imports <https://arco.ai/ontology/governance> .

#################################################################
# 1) REGULATORY LAYER — Annex III 5(b)
#################################################################

# Mereological backbone (CLAUDE.md invariant 8): every modeled Annex III condition
# is `bfo:0000051` of `:AnnexIII_List`. The list is also re-asserted here with its
# rdf:type so this fixture is self-contained when loaded standalone (test_scenarios.py
# loads each fixture independently). Duplicate triples across fixtures are deduped
# at union time. See runs/loop/2026-05-09_beverley-research/audit_C_regulatory.md T2.
:AnnexIII_List rdf:type :RegulatoryContent ;
  bfo:0000051 :AnnexIII_Condition_5b .

:AnnexIII_Condition_5b rdf:type :RegulatoryContent ;
  rdfs:label "Annex III 5(b) (Creditworthiness Rule)" ;
  rdfs:comment "Annex III item 5(b): AI systems intended to be used to evaluate the creditworthiness of natural persons or establish their credit score, with the exception of AI systems used for the purpose of detecting financial fraud. cco:prescribes targets the regulated process TYPE (class IRI as concept-individual via OWL 2 punning) — the regulation prescribes process types, not deployment-specific tokens. This matches the Sentinel pattern and generalizes across multiple 5(b) assessments sharing this single regulatory ICE." ;
  cco:prescribes :CreditworthinessEvaluationProcess ;
  iao:0000136 :CreditworthinessEvaluationCapability ;
  iao:0000136 :CreditworthinessEvaluationProcess ;
  iao:0000136 :NaturalPersonRole .

#################################################################
# 2) SYSTEM LAYER (reality-side particulars)
#################################################################

:CreditScorer_Eval_Disposition rdf:type :CreditworthinessEvaluationCapability ;
  rdfs:label "Credit Scorer Evaluation Disposition" .

:CreditScorer_Processing_Module rdf:type :HardwareComponent ;
  rdfs:label "Credit Scorer Processing Module" ;
  rdfs:comment "Hardware component bearing creditworthiness evaluation capability. No biometric identification capability." ;
  ro:0000091 :CreditScorer_Eval_Disposition .

:CreditScorer_001 rdf:type :System ;
  rdfs:label "Credit Scorer 001" ;
  rdfs:comment "AI system that evaluates creditworthiness of natural persons for access to financial services. Entailed as AnnexIII5bApplicableSystem and HighRiskSystem. No biometric identification capability — NOT entailed as AnnexIII1aApplicableSystem." ;
  bfo:0000051 :CreditScorer_Processing_Module .

#################################################################
# 2b) INTENDED USE + USE SCENARIO
#
# Gate 2: IntendedUseSpecification must cco:prescribes a token
# typed as :CreditworthinessEvaluationProcess — the Gate 2
# type-check target for AnnexIII5bApplicableSystem.
# Gate 3: UseScenarioSpecification (a Designative ICE) must
# cco:designates :NaturalPersonRole — designation references the
# role universal directly via a typed designation property whose
# range admits universals. No role-bearer required.
#################################################################

:CreditScorer_EvalProcess_Token rdf:type :CreditworthinessEvaluationProcess ;
  rdfs:label "Credit Scorer Evaluation Process Token" .

:CreditScorer_IntendedUse_001 rdf:type :IntendedUseSpecification ;
  rdfs:label "Credit Scorer Intended Use: Creditworthiness Evaluation" ;
  cco:prescribes :CreditScorer_EvalProcess_Token ;
  iao:0000136 :CreditScorer_001 .

:CreditScorer_UseScenario_001 rdf:type :UseScenarioSpecification ;
  rdfs:label "Credit Scorer Use Scenario: Natural Person Applicants" ;
  rdfs:comment "Designative ICE: is_about the system, designates :NaturalPersonRole as the affected role category via cco:designates." ;
  iao:0000136 :CreditScorer_001 ;
  cco:designates :NaturalPersonRole .

#################################################################
# 3) COMPLIANCE DETERMINATION
#################################################################

:CreditScorer_Determination_001 rdf:type :HighRiskDetermination ;
  rdfs:label "Credit Scorer High-Risk Determination (Annex III 5b)" ;
  rdfs:comment "Documents the Annex III 5(b) classification. AnnexIII5bApplicableSystem and HighRiskSystem membership are INFERRED by the reasoner — this determination records the inference." ;
  iao:0000136 :CreditScorer_001 ;
  iao:0000136 :AnnexIII_Condition_5b .

#################################################################
# 4) PROVIDER + DOCUMENTATION WORKFLOW
#################################################################

:CreditScorerProviderOrg_001 rdf:type :ProviderOrganization ;
  rdfs:label "Credit Scorer Provider Org (Example)" ;
  ro:0000087 :CreditScorerProviderRole_001 .

:CreditScorerProviderRole_001 rdf:type :ProviderRole ;
  rdfs:label "Credit Scorer Provider Role" ;
  ro:0000052 :CreditScorerProviderOrg_001 .

:CreditScorerAssessmentDocProcess_001 rdf:type :AssessmentDocumentationProcess ;
  rdfs:label "Credit Scorer Assessment Documentation Process 001" ;
  ro:0000057 :CreditScorer_001 ;
  ro:0000057 :CreditScorerProviderOrg_001 ;
  cco:has_output :CreditScorerAssessmentDoc_001 .

:CreditScorerAssessmentDoc_001 rdf:type :AssessmentDocumentation ;
  rdfs:label "Credit Scorer Assessment Documentation 001" ;
  iao:0000136 :CreditScorer_001 ;
  iao:0000136 :AnnexIII_Condition_5b .

#################################################################
# 5) COMPLIANCE OBLIGATION
#################################################################

:CreditScorerObligation_001 rdf:type :ComplianceObligationSpecification ;
  rdfs:label "Provider Compliance Obligation for Credit Scorer" ;
  rdfs:comment "Specifies that the provider has compliance obligations for CreditScorer_001 under Annex III 5(b)." ;
  iao:0000136 :CreditScorer_001 ;
  iao:0000136 :CreditScorerProviderRole_001 ;
  iao:0000136 :AnnexIII_Condition_5b .
