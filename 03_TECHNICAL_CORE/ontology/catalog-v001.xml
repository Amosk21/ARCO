<?xml version="1.0" encoding="UTF-8"?>
<!-- ARCO ontology IRI catalog (OASIS XML Catalog).

     This catalog maps ARCO's ontology IRIs to the pinned local files in
     this directory. The https://arco.ai/... IRIs below are currently
     unresolvable on the web; this catalog is the authoritative mapping to
     the pinned local files, regardless of what that domain serves in the
     future. Pins: BFO 2020 (ISO/IEC 21838-2:2021); RO release 2025-12-17,
     IAO release 2026-03-30, CCO release v1.7-2024-11-03, each as a ROBOT
     BOT-extracted slim module (seeds at imports/seeds/).

     Protege and ROBOT auto-detect this file (both look for catalog-v001.xml
     in the directory of the loaded file), so loads that start from any
     ontology file in this directory resolve locally with zero configuration.

     This catalog and the owl:imports declarations in ARCO_core.ttl must
     change together: every declared import IRI needs an entry here, and a
     catalog entry for a never-imported IRI is dead configuration. Fixture
     ontology IRIs other than https://arco.ai/ontology/instances are not
     mapped: no file imports them. -->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog" prefer="public">
  <uri name="https://arco.ai/ontology/core" uri="ARCO_core.ttl"/>
  <uri name="https://arco.ai/ontology/governance" uri="ARCO_governance_extension.ttl"/>
  <uri name="https://arco.ai/ontology/instances" uri="ARCO_instances_sentinel.ttl"/>
  <uri name="https://arco.ai/ontology/imports/bfo-2020" uri="imports/bfo-2020.owl"/>
  <uri name="https://arco.ai/ontology/imports/ro_bot" uri="imports/ro_bot.owl"/>
  <uri name="https://arco.ai/ontology/imports/iao_bot" uri="imports/iao_bot.owl"/>
  <uri name="https://arco.ai/ontology/imports/cco_bot" uri="imports/cco_bot.owl"/>
</catalog>
