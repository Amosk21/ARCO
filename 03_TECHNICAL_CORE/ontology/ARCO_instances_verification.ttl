@prefix :    <https://arco.ai/ontology/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix ro:  <http://purl.obolibrary.org/obo/RO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://arco.ai/ontology/instances/verification> rdf:type owl:Ontology ;
  rdfs:label "ARCO Verification Kiosk Instances — Annex III 1(a) Negative Case" ;
  rdfs:comment """Demonstrates that a system bearing BiometricVerificationCapability (1:1) is NOT entailed as AnnexIII1aApplicableSystem.

  Why: BiometricVerificationCapability is NOT a subclass of BiometricIdentificationCapability and NOT in AnnexIIITriggeringCapability. Gate 1 of AnnexIII1aApplicableSystem requires has_disposition some AnnexIIITriggeringCapability, which BiometricVerificationCapability does not satisfy.

  Non-entailment claim: AnnexIII1aApplicableSystem is not entailed for VerificationKiosk_001 under current assertions (OWA — no closed-world guarantee).

  Legal basis: Recital 22 and Art. 3(41) EU AI Act — 1:1 biometric verification is excluded from Annex III 1(a); only 1:N remote biometric identification triggers classification.""" ;
  owl:imports <https://arco.ai/ontology/governance> .

#################################################################
# 1) REGULATORY LAYER — exclusion documentation
#################################################################

:AnnexIII_Condition_1a_Exclusion rdf:type :RegulatoryContent ;
  rdfs:label "Annex III 1(a) — Verification Exclusion Note" ;
  rdfs:comment "Documents the 1:1 verification exclusion from Annex III 1(a). Recital 22 and Art. 3(41): only 1:N remote biometric identification triggers the Annex III classification." ;
  iao:0000136 :BiometricVerificationCapability ;
  iao:0000136 :BiometricIdentificationCapability .

#################################################################
# 2) SYSTEM LAYER (reality-side particulars)
#################################################################

:Kiosk_VeriComp_Disposition rdf:type :BiometricVerificationCapability ;
  rdfs:label "Kiosk Biometric Verification Disposition" .

:Kiosk_VeriComp_Module rdf:type :HardwareComponent ;
  rdfs:label "Kiosk Biometric Verification Module" ;
  rdfs:comment "Hardware component asserted to bear 1:1 verification capability under this deployment's reviewed commitments. Identification capability is not asserted; whether the underlying hardware could in principle realize identification under a different configuration is not adjudicated by ARCO (see LIMITATIONS §3.5 on software-configurable bearers)." ;
  ro:0000091 :Kiosk_VeriComp_Disposition .

:VerificationKiosk_001 rdf:type :System ;
  rdfs:label "Verification Kiosk 001" ;
  rdfs:comment "A 1:1 identity verification kiosk under this deployment's reviewed commitments. The asserted disposition is :BiometricVerificationCapability, which is not a member of the :AnnexIIITriggeringCapability owl:unionOf; under current commitments, identification is not entailed and Annex III 1(a) is not entailed. ARCO does not claim hardware-incapability under OWA (LIMITATIONS §3.5, §3.6)." ;
  bfo:0000051 :Kiosk_VeriComp_Module .

#################################################################
# 2b) INTENDED USE + USE SCENARIO
#################################################################

:Kiosk_IntendedUse_001 rdf:type :IntendedUseSpecification ;
  rdfs:label "Kiosk Intended Use: Biometric Verification (1:1)" ;
  cco:prescribes :Kiosk_VerificationProcess_Token ;
  iao:0000136 :VerificationKiosk_001 .

:Kiosk_VerificationProcess_Token rdf:type :BiometricVerificationProcess ;
  rdfs:label "Kiosk Verification Process Token" .

:Kiosk_UseScenario_001 rdf:type :UseScenarioSpecification ;
  rdfs:label "Kiosk Use Scenario: Verification of Natural Persons" ;
  rdfs:comment "Designative ICE: is_about the system, designates :NaturalPersonRole. Gate 3 is satisfied; the kiosk still does NOT entail AnnexIII1aApplicableSystem because Gate 1 fails (BiometricVerificationCapability is not in AnnexIIITriggeringCapability)." ;
  iao:0000136 :VerificationKiosk_001 ;
  cco:designates :NaturalPersonRole .

#################################################################
# 3) COMPLIANCE DETERMINATION (descriptive ICE — not high-risk)
#
# ComplianceDetermination (not HighRiskDetermination) — the OWL
# reasoner does not entail AnnexIII1aApplicableSystem for this
# system, so a HighRiskDetermination would be incorrect.
#################################################################

:Kiosk_Determination_001 rdf:type :ComplianceDetermination ;
  rdfs:label "Kiosk Compliance Determination: NOT Annex III 1(a)" ;
  rdfs:comment "Documents the non-entailment: AnnexIII1aApplicableSystem is not inferred for VerificationKiosk_001 because BiometricVerificationCapability is not in AnnexIIITriggeringCapability. Gate 1 fails." ;
  iao:0000136 :VerificationKiosk_001 ;
  iao:0000136 :AnnexIII_Condition_1a_Exclusion .

#################################################################
# 4) PROVIDER + DOCUMENTATION WORKFLOW
#################################################################

:KioskProviderOrg_001 rdf:type :ProviderOrganization ;
  rdfs:label "Kiosk Provider Org (Example)" ;
  ro:0000087 :KioskProviderRole_001 .

:KioskProviderRole_001 rdf:type :ProviderRole ;
  rdfs:label "Kiosk Provider Role" ;
  ro:0000052 :KioskProviderOrg_001 .

:KioskAssessmentDocProcess_001 rdf:type :AssessmentDocumentationProcess ;
  rdfs:label "Kiosk Assessment Documentation Process 001" ;
  ro:0000057 :VerificationKiosk_001 ;
  ro:0000057 :KioskProviderOrg_001 ;
  cco:has_output :KioskAssessmentDoc_001 .

:KioskAssessmentDoc_001 rdf:type :AssessmentDocumentation ;
  rdfs:label "Kiosk Assessment Documentation 001" ;
  iao:0000136 :VerificationKiosk_001 ;
  iao:0000136 :AnnexIII_Condition_1a_Exclusion .

#################################################################
# 5) CONCRETIZATION BEARER SLOTS (currently HYPOTHETICAL)
#
# An IntendedUseSpecification and a UseScenarioSpecification are
# information artifacts. In BFO 2020 terms they are generically
# dependent continuants, which means they exist by being concretized
# in something more specific: an inscription on a particular document,
# a pattern of bits in a particular file, a structured arrangement on
# a particular screen. Without that link, the specification is
# correctly typed but not anchored in anything real.
#
# Why this block matters. The kiosk source packet is HYPOTHETICAL
# today (see docs/kiosk_demo_v1/source_packet.md). When ARCO is
# applied to a real published kiosk specification (a vendor product
# page, an EU AI Act compliance filing, a public NIST AI RMF example),
# the steps to close the realist chain are mechanical:
#   1. Add a typed instance for the real document file (a Material
#      Entity with file hash, retrieval timestamp, source citation).
#   2. Add a typed instance for the inscription quality on that file
#      (a Specifically Dependent Continuant that characterizes the
#      file via ro:0000052, which ARCO commits as a specialization of
#      bfo:0000197 in ARCO_core.ttl section 5).
#   3. Assert that the inscription concretizes the specification ICE
#      via bfo:0000059 (BFO 2020 "concretizes": b concretizes c =Def
#      b is a process or specifically dependent continuant, c is a
#      generically dependent continuant, c is the pattern b shares
#      with actual or potential copies).
#
# The block below shows that shape with placeholder IRIs. The block
# is commented out because uncommenting it without a real document
# would assert reality-side particulars the source ledger does not
# license, which is the fake-witness discipline the
# EVIDENCE_TO_COMMITMENT_POLICY rules out.
#
# Related: OPEN_PROBLEMS L2.2 tracks the equivalent slot for the
# pipeline-emitted side (the determination output ICE concretizes in
# the certificate.txt file the pipeline writes). The slot pattern
# below is the source-side analogue. Both halves together close the
# realist chain from real input documents through the reasoner to
# real output files.
#################################################################

# Slot 1. The source document particular.
# When the kiosk source is real, fill in the file hash, retrieval
# timestamp, and source URL or path. The IRI naming flag below
# ("PLACEHOLDER") marks that the entity has no real-world referent yet.
#
# :Kiosk_SourceDoc_PLACEHOLDER rdf:type bfo:0000040 ;  # Material Entity
#   rdfs:label "Kiosk Product Specification (PLACEHOLDER)" ;
#   rdfs:comment "Slot for the real source document particular. Replace when the kiosk source becomes real per OPEN_PROBLEMS L1.1. Properties to add when real: file hash, retrieval timestamp, source URL, document title." .

# Slot 2. The inscription on the source document.
# The inscription is a specifically dependent continuant that
# characterizes the document (ro:0000052, bound to bfo:0000197 in
# ARCO_core.ttl section 5) and concretizes the specification ICEs it
# expresses (bfo:0000059).
#
# :Kiosk_SourceDoc_Inscription_PLACEHOLDER rdf:type bfo:0000020 ;  # SDC
#   rdfs:label "Kiosk Source Inscription (PLACEHOLDER)" ;
#   ro:0000052 :Kiosk_SourceDoc_PLACEHOLDER ;  # characteristic_of (inheres in) the document
#   bfo:0000059 :Kiosk_IntendedUse_001 ;  # concretizes the IntendedUseSpecification
#   bfo:0000059 :Kiosk_UseScenario_001 .  # concretizes the UseScenarioSpecification
