@prefix :    <https://arco.ai/ontology/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix ro:  <http://purl.obolibrary.org/obo/RO_> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://arco.ai/ontology/probes/gate2-mistyped-kind> rdf:type owl:Ontology ;
  rdfs:label "GUARD FIXTURE — Gate-2 filler mistyped as the wrong regulated kind" ;
  rdfs:comment """GUARD FIXTURE — content-sensitivity regression input (Global Invariant 3).

  Intended repo location: 03_TECHNICAL_CORE/ontology/probes/ (kept OUT of the
  fixture battery: the ARCO_instances_*.ttl globs and ontology/*.ttl sweeps are
  non-recursive and do not descend into probes/). Used ONLY by
  test_gate2_mistype.py. This file reuses the sentinel fixture's individual
  IRIs deliberately — its logic delta from that fixture is exactly one rdf:type triple (header and some annotation triples differ) and it is never
  loaded together with it.

  Construction: copy of ARCO_instances_sentinel.ttl EXCEPT one triple — the
  Gate-2 prescribed token :Sentinel_RBIP_Process is typed
  :BiometricVerificationProcess (the 1:1 verification kind) instead of
  :RemoteBiometricIdentificationProcess. Everything else, including the
  iao:0000136 aboutness references to :RemoteBiometricIdentificationProcess
  on the IUS and USS, carries the same logic triples.

  Expected behavior (pinned by test_gate2_mistype.py): Annex III 1(a) NOT
  entailed — Gate 2 goes through the IUS subkind
  :RemoteBiometricIdentificationIntendedUseSpec, defined by
  owl:someValuesFrom :RemoteBiometricIdentificationProcess, a genuine
  type-check on the prescribed token, not an existence check on the IUS.
  :HighRiskSystem (capability-only bridge) IS still entailed and the latent-risk
  audit still fires: the mistyped-intent mutant lands exactly where the design
  says it should — no Annex III category classification, latent-disposition
  flag present.""" .

#################################################################
# 2) SYSTEM LAYER (same logic triples as the sentinel fixture)
#################################################################

:Sentinel_FaceID_Module rdf:type :HardwareComponent ;
  rdfs:label "Sentinel Facial Recognition Module" ;
  rdfs:comment "Hardware component containing biometric sensors and processing capability." ;
  ro:0000091 :Sentinel_FaceID_Disposition . # has disposition

:Sentinel_ID_System rdf:type :System ;
  rdfs:label "Sentinel-ID System" ;
  bfo:0000051 :Sentinel_FaceID_Module . # has part

:Sentinel_FaceID_Disposition rdf:type :BiometricIdentificationCapability ;
  rdfs:label "Sentinel Facial Recognition Disposition" .

#################################################################
# 2b) INTENDED USE + USE SCENARIO
# GUARD CHANGE: the prescribed token is typed :BiometricVerificationProcess
# (wrong regulated kind for 1(a) Gate 2). This is the ONLY changed triple.
#################################################################

:Sentinel_RBIP_Process rdf:type :BiometricVerificationProcess ;
  rdfs:label "Sentinel Prescribed Process Token (GUARD: mistyped as 1:1 verification)" ;
  rdfs:comment "GUARD: token typed :BiometricVerificationProcess instead of :RemoteBiometricIdentificationProcess. Gate 2's someValuesFrom type-check must NOT be satisfied by this token." .

:Sentinel_IntendedUse_001 rdf:type :IntendedUseSpecification ;
  rdfs:label "Sentinel Intended Use: Remote Biometric Identification" ;
  cco:prescribes :Sentinel_RBIP_Process ;
  iao:0000136 :Sentinel_ID_System ;
  iao:0000136 :RemoteBiometricIdentificationProcess .

:Sentinel_UseScenario_001 rdf:type :UseScenarioSpecification ;
  rdfs:label "Sentinel Use Scenario: Biometric ID of Natural Persons" ;
  rdfs:comment "Designative ICE: is_about the system; cco:designates :NaturalPersonRole with the class IRI as a named individual (OWL 2 punning; the Gate-3 entailment consumes the IRI only in its individual interpretation). No role-bearer token is minted (L2.4); category designation is documented modeling intent, not a CCO-documented use (LIMITATIONS 3.1)." ;
  iao:0000136 :Sentinel_ID_System ;
  iao:0000136 :RemoteBiometricIdentificationProcess ;
  iao:0000136 cco:Person ;
  cco:designates :NaturalPersonRole .

#################################################################
# 3) OPERATIONAL LAYER (same logic triples as the sentinel fixture)
#################################################################

:Surveillance_Run_001 rdf:type :OperationalProcess ;
  rdfs:label "Surveillance Run 001" ;
  ro:0000057 :Sentinel_ID_System ;           # has participant
  bfo:0000055 :Sentinel_FaceID_Disposition ; # realizes
  cco:has_output :FaceData_Log_001 .         # has output

:FaceData_Log_001 rdf:type :InformationOutput ;
  rdfs:label "Face Data Log 001" ;
  iao:0000136 :Sentinel_ID_System .

#################################################################
# 4) COMPLIANCE DETERMINATION (same logic triples as the sentinel fixture)
#################################################################

:HighRisk_Determination_001 rdf:type :HighRiskDetermination ;
  rdfs:label "High-Risk Determination 001" ;
  iao:0000136 :Sentinel_ID_System ;
  iao:0000136 :AnnexIII_Condition_1a ;
  rdfs:comment "This determination artifact documents the compliance assessment. The system's classification as HighRiskSystem is INFERRED by the reasoner from the bridge axioms. GUARD NOTE: under the mistyped Gate-2 token, no 1(a) inference is expected; this artifact is retained so the logic delta from the sentinel fixture stays at exactly one rdf:type triple." .

#################################################################
# 5) PROVIDER + DOCUMENTATION WORKFLOW (same logic triples as the sentinel fixture)
#################################################################

:ProviderOrg_001 rdf:type :ProviderOrganization ;
  rdfs:label "Sentinel-ID Provider Org (Example)" ;
  ro:0000087 :ProviderRole_001 .

:ProviderRole_001 rdf:type :ProviderRole ;
  rdfs:label "Provider Role (bearer: ProviderOrg_001)" ;
  ro:0000052 :ProviderOrg_001 .  # inheres in

:AssessmentDocProcess_001 rdf:type :AssessmentDocumentationProcess ;
  rdfs:label "Assessment Documentation Process 001" ;
  ro:0000057 :Sentinel_ID_System ;
  ro:0000057 :ProviderOrg_001 ;
  cco:has_output :AssessmentDoc_001 .

:AssessmentDoc_001 rdf:type :AssessmentDocumentation ;
  rdfs:label "Assessment Documentation 001" ;
  iao:0000136 :Sentinel_ID_System ;
  iao:0000136 :AnnexIII_Condition_1a .

#################################################################
# 6) COMPLIANCE OBLIGATION (same logic triples as the sentinel fixture)
#################################################################

:ProviderObligation_001 rdf:type :ComplianceObligationSpecification ;
  rdfs:label "Provider Compliance Obligation for Sentinel-ID" ;
  rdfs:comment "Specifies that the provider role-bearer has compliance obligations for the Sentinel-ID system under Annex III 1(a)." ;
  iao:0000136 :Sentinel_ID_System ;
  iao:0000136 :ProviderRole_001 ;
  iao:0000136 :AnnexIII_Condition_1a .
