PREFIX : <https://arco.ai/ontology/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Audit check: confirms the reasoner inferred Annex III 5(b) applicability.
# Classification itself is an OWL entailment — this just verifies it materialized.
#
# Cross-category isolation:
#   Sentinel_ID_System (default): FALSE — no CreditworthinessEvaluationCapability; Gate 1 of 5(b) fails.
#   CreditScorer_001: TRUE after reasoning — all three gates satisfied.
#
# The ?system variable is bound by the caller (rdflib initBindings or
# ROBOT --initial-binding) to the system IRI under evaluation.

ASK WHERE {
  ?system rdf:type :AnnexIII5bApplicableSystem .
}
