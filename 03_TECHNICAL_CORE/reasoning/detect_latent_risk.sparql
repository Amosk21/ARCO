PREFIX : <https://arco.ai/ontology/core#>
PREFIX bfo: <http://purl.obolibrary.org/obo/BFO_>
PREFIX ro: <http://purl.obolibrary.org/obo/RO_>

#################################################################
# detect_latent_risk.sparql
#
# PURPOSE: Detect latent Annex III regulatory risk via component traversal
#
# QUERY PATTERN:
#   System → has_part → HardwareComponent → has_disposition →
#   AnnexIIITriggeringCapability (or any subclass thereof)
#
# This query detects regulatory risk at the hardware level for any
# Annex III category, even when the capability is not currently active.
# AnnexIIITriggeringCapability is entailed by OWL-RL subclass reasoning
# for all registered capability subclasses (e.g. BiometricIdentificationCapability,
# CreditworthinessEvaluationCapability).
#
# The ?system variable is bound by the caller (rdflib initBindings or ROBOT
# --initial-binding) to the system IRI under evaluation.
#################################################################

ASK WHERE {
  ?system bfo:0000051 ?component .
  ?component ro:0000091 ?disposition .
  ?disposition a :AnnexIIITriggeringCapability .
}
