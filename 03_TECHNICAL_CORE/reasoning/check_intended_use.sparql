PREFIX : <https://arco.ai/ontology/core#>
PREFIX cco: <http://www.ontologyrepository.com/CommonCoreOntologies/>
PREFIX iao: <http://purl.obolibrary.org/obo/IAO_>

# AUDIT LAYER — documentary structure check, not classification mechanism.
# AnnexIII applicability is OWL-entailed by gate axioms in ARCO_governance_extension.ttl.
# This query verifies the asserted documentary structure supporting Gates 2 and 3:
#
# Gate 2 audit: an IntendedUseSpecification is_about the system AND prescribes
# a process instance. The process type is enforced by the OWL gate axiom
# (owl:someValuesFrom on the category-specific process class); this query
# confirms the prescribed process token exists.
#
# Gate 3 audit: a UseScenarioSpecification is_about the system AND is_about
# an instance typed as :NaturalPersonRole (a role token; the OWL gate axiom
# enforces the type via owl:someValuesFrom).
#
# The pipeline substitutes :Sentinel_ID_System with the actual system IRI when
# --system is provided.

ASK WHERE {
  # Gate 2 audit: intended use — a directive ICE prescribes a process instance for this system
  ?ius a :IntendedUseSpecification ;
    cco:prescribes ?process ;
    iao:0000136 :Sentinel_ID_System .

  # Gate 3 audit: use scenario — a NaturalPersonRole token is declared for this system
  ?uss a :UseScenarioSpecification ;
    iao:0000136 :Sentinel_ID_System ;
    iao:0000136 ?role .
  ?role a :NaturalPersonRole .
}
