PREFIX : <https://arco.ai/ontology/core#>
PREFIX iao: <http://purl.obolibrary.org/obo/IAO_>

# System-agnostic: checks that some AssessmentDocumentation is about
# both a System and a RegulatoryContent in this graph.
ASK WHERE {
  ?doc a :AssessmentDocumentation ;
    iao:0000136 ?system ;
    iao:0000136 ?condition .
  ?system a :System .
  ?condition a :RegulatoryContent .
}
